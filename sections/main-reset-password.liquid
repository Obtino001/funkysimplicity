{% render 'customer-styles' %}

<div class="fs-customer-page">
  <div class="fs-customer-card">
    <h1 class="fs-customer-title">Reset Account Password</h1>
    <p class="fs-customer-subtitle">Enter a new password for {{ email | default: 'your account' }}.</p>

    {% form 'reset_customer_password', class: 'fs-customer-form' %}
      {% if form.errors %}
        <div class="fs-customer-alert fs-customer-alert--error">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div class="fs-customer-field">
        <label class="fs-customer-label" for="password">Password</label>
        <input type="password" name="customer[password]" id="password" class="fs-customer-input" autocomplete="new-password" required>
      </div>

      <div class="fs-customer-field">
        <label class="fs-customer-label" for="password_confirmation">Confirm Password</label>
        <input type="password" name="customer[password_confirmation]" id="password_confirmation" class="fs-customer-input" autocomplete="new-password" required>
      </div>

      <div class="fs-customer-actions">
        <button type="submit" class="fs-customer-btn" style="width: 100%;">Reset Password</button>
      </div>
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Reset Password",
  "settings": []
}
{% endschema %}
