{%- comment -%}
  Icon Features Bar / Trust Badges Section
  Displays 4 value proposition items in a clean row with vertical dividers and vector line icons:
  1. High Quality Fabrics (Feather on fabric)
  2. Handmade Fairly In Bali (Ribbon badge with star)
  3. 4 Way Stretch Cotton (4-way stretch diamond)
  4. Original Swiss Artwork (Hand holding diamond)
{%- endcomment -%}

{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#f8f8f8'
  assign text_color = section.settings.text_color | default: '#121212'
  assign icon_color = section.settings.icon_color | default: '#121212'
  assign divider_color = section.settings.divider_color | default: '#e5e5e5'
  assign show_dividers = section.settings.show_dividers
  assign icon_size = section.settings.icon_size | default: 38
  assign font_size = section.settings.font_size | default: 15
  assign section_width = section.settings.section_width | default: 'full-width'
  assign padding_top = section.settings.padding_top | default: 36
  assign padding_bottom = section.settings.padding_bottom | default: 36
-%}

<section
  id="IconFeaturesBar-{{ section_id }}"
  class="icon-features-bar section-{{ section_id }}"
  style="
    --ifb-bg: {{ bg_color }};
    --ifb-text-color: {{ text_color }};
    --ifb-icon-color: {{ icon_color }};
    --ifb-divider-color: {{ divider_color }};
    --ifb-icon-size: {{ icon_size }}px;
    --ifb-font-size: {{ font_size }}px;
    --ifb-padding-top: {{ padding_top }}px;
    --ifb-padding-bottom: {{ padding_bottom }}px;
  "
>
  <div class="ifb-container {% if section_width == 'page-width' %}page-width{% endif %}">
    <div class="ifb-grid{% if show_dividers %} ifb-grid--dividers{% endif %}">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign title = block.settings.title
            assign link = block.settings.link
          -%}
          <div class="ifb-item" {{ block.shopify_attributes }}>
            <{% if link != blank %}a href="{{ link }}"{% else %}div{% endif %}
              class="ifb-item__inner"
            >
              <div class="ifb-item__icon-wrap">
                {%- if block.settings.custom_svg != blank -%}
                  <div class="ifb-item__svg">
                    {{ block.settings.custom_svg }}
                  </div>
                {%- elsif block.settings.custom_image != blank -%}
                  <img
                    src="{{ block.settings.custom_image | image_url: width: 100 }}"
                    alt="{{ title | escape }}"
                    class="ifb-item__img"
                    width="{{ icon_size }}"
                    height="{{ icon_size }}"
                    loading="lazy"
                  >
                {%- else -%}
                  {%- case block.settings.icon -%}
                    {%- when 'feather_fabric' -%}
                      {%- comment -%} Feather on Fabric Sheet {%- endcomment -%}
                      <svg class="ifb-svg" viewBox="0 0 44 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <!-- Folded fabric base -->
                        <path d="M6 31L18 36L38 29L26 24L6 31Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <!-- Feather emerging up -->
                        <path d="M29 5C23 6 17 12 17 21C17 25 18 29 19 32" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M29 5C29 11 25 17 19 22" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M26 12C28 13.5 29 16 28 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        <path d="M20 18C22 19 23 21 23 23" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                      </svg>

                    {%- when 'badge_star' -%}
                      {%- comment -%} Ribbon Rosette Badge with Star {%- endcomment -%}
                      <svg class="ifb-svg" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <!-- Scalloped Rosette Circle -->
                        <circle cx="20" cy="17" r="11" stroke="currentColor" stroke-width="1.8" stroke-dasharray="2 2" stroke-linecap="round"/>
                        <circle cx="20" cy="17" r="9" stroke="currentColor" stroke-width="1.8"/>
                        <!-- Center 5-Point Star -->
                        <path d="M20 12.5L21.3 15.3L24.3 15.7L22.1 17.8L22.6 20.8L20 19.3L17.4 20.8L17.9 17.8L15.7 15.7L18.7 15.3L20 12.5Z" fill="currentColor"/>
                        <!-- Hanging Ribbons -->
                        <path d="M15 25L13 35L17 33L20 35L20 27" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M25 25L27 35L23 33L20 35" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>

                    {%- when 'stretch' -%}
                      {%- comment -%} 4-Way Stretch Diamond {%- endcomment -%}
                      <svg class="ifb-svg" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <!-- Outer curved diamond frame -->
                        <path d="M6 6C12 12 12 28 6 34C12 28 28 28 34 34C28 28 28 12 34 6C28 12 12 12 6 6Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <!-- 4 Corner Arrows -->
                        <path d="M15 17L18 14M15 17H18M15 17V14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M25 17L22 14M25 17H22M25 17V14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M15 23L18 26M15 23H18M15 23V26" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M25 23L22 26M25 23H22M25 23V26" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>

                    {%- when 'hand_diamond' -%}
                      {%- comment -%} Hand holding Diamond (Swiss Artwork) {%- endcomment -%}
                      <svg class="ifb-svg" viewBox="0 0 44 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <!-- Sparkling Diamond -->
                        <path d="M22 6L16 12L22 20L28 12L22 6Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M16 12H28" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        <path d="M19 6L18 12L22 20L26 12L25 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <!-- Sparkles -->
                        <line x1="12" y1="7" x2="14" y2="7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        <line x1="30" y1="7" x2="32" y2="7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        <!-- Cupping Hand -->
                        <path d="M9 28C13 25 18 25 23 27L29 27C31 27 34 25 35 24C35.5 24.5 35.5 25.5 34.5 26.5L30 30C26 33 21 33 17 31L9 31" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M9 25L13 25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                      </svg>

                    {%- when 'leaf' -%}
                      <svg class="ifb-svg" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M32 9C20 9 10 19 10 31C22 31 32 21 32 9Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M10 31C16 25 24 17 32 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                      </svg>

                    {%- when 'shield' -%}
                      <svg class="ifb-svg" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M20 7L31 11V19C31 27 25 32 20 34C15 32 9 27 9 19V11L20 7Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M16 19L19 22L25 16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                  {%- endcase -%}
                {%- endif -%}
              </div>

              {%- if title != blank -%}
                <span class="ifb-item__title">{{ title }}</span>
              {%- endif -%}
            </{% if link != blank %}a{% else %}div{% endif %}>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Default 4 items {%- endcomment -%}
        <div class="ifb-item">
          <div class="ifb-item__inner">
            <div class="ifb-item__icon-wrap">
              <svg class="ifb-svg" viewBox="0 0 44 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 31L18 36L38 29L26 24L6 31Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M29 5C23 6 17 12 17 21C17 25 18 29 19 32" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M29 5C29 11 25 17 19 22" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <span class="ifb-item__title">High Quality Fabrics</span>
          </div>
        </div>

        <div class="ifb-item">
          <div class="ifb-item__inner">
            <div class="ifb-item__icon-wrap">
              <svg class="ifb-svg" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="20" cy="17" r="9" stroke="currentColor" stroke-width="1.8"/>
                <path d="M20 12.5L21.3 15.3L24.3 15.7L22.1 17.8L22.6 20.8L20 19.3L17.4 20.8L17.9 17.8L15.7 15.7L18.7 15.3L20 12.5Z" fill="currentColor"/>
                <path d="M15 25L13 35L17 33L20 35L20 27" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M25 25L27 35L23 33L20 35" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <span class="ifb-item__title">Handmade Fairly In Bali</span>
          </div>
        </div>

        <div class="ifb-item">
          <div class="ifb-item__inner">
            <div class="ifb-item__icon-wrap">
              <svg class="ifb-svg" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 6C12 12 12 28 6 34C12 28 28 28 34 34C28 28 28 12 34 6C28 12 12 12 6 6Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M15 17L18 14M15 17H18M15 17V14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M25 17L22 14M25 17H22M25 17V14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M15 23L18 26M15 23H18M15 23V26" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M25 23L22 26M25 23H22M25 23V26" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <span class="ifb-item__title">4 Way Stretch Cotton</span>
          </div>
        </div>

        <div class="ifb-item">
          <div class="ifb-item__inner">
            <div class="ifb-item__icon-wrap">
              <svg class="ifb-svg" viewBox="0 0 44 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M22 6L16 12L22 20L28 12L22 6Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M9 28C13 25 18 25 23 27L29 27C31 27 34 25 35 24C35.5 24.5 35.5 25.5 34.5 26.5L30 30C26 33 21 33 17 31L9 31" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <span class="ifb-item__title">Original Swiss Artwork</span>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .icon-features-bar {
    position: relative;
    width: 100%;
    background-color: var(--ifb-bg, #f8f8f8);
    color: var(--ifb-text-color, #121212);
    box-sizing: border-box;
    padding-block-start: var(--ifb-padding-top, 36px);
    padding-block-end: var(--ifb-padding-bottom, 36px);
  }

  .ifb-container {
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    box-sizing: border-box;
  }

  .ifb-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
    width: 100%;
  }

  .ifb-item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-inline: 1.25rem;
    box-sizing: border-box;
  }

  /* Vertical Dividers */
  .ifb-grid--dividers .ifb-item:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 15%;
    bottom: 15%;
    width: 1px;
    background-color: var(--ifb-divider-color, #e5e5e5);
  }

  .ifb-item__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    text-decoration: none;
    color: inherit;
    width: 100%;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  a.ifb-item__inner:hover {
    transform: translateY(-2px);
    opacity: 0.8;
  }

  .ifb-item__icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ifb-icon-color, #121212);
    width: var(--ifb-icon-size, 38px);
    height: var(--ifb-icon-size, 38px);
    flex-shrink: 0;
  }

  .ifb-svg,
  .ifb-item__svg svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .ifb-item__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .ifb-item__title {
    margin: 0;
    font-family: var(--font-body--family, sans-serif);
    font-size: var(--ifb-font-size, 15px);
    font-weight: 500;
    line-height: 1.3;
    color: var(--ifb-text-color, #121212);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  /* Responsive Mobile */
  @media screen and (max-width: 989px) {
    .ifb-grid {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 2rem;
    }

    .ifb-grid--dividers .ifb-item:nth-child(2n)::after {
      display: none;
    }
  }

  @media screen and (max-width: 549px) {
    .icon-features-bar {
      padding-block: 28px;
    }

    .ifb-grid {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 1.5rem;
    }

    .ifb-item {
      padding-inline: 0.75rem;
    }

    .ifb-item__title {
      font-size: 16px;
    }

    .ifb-item__img {
      width: 50px;
      height: 50px;
    }
  }
</style>

{% schema %}
{
  "name": "Icon Features Bar",
  "class": "section-icon-features-bar",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Appearance & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#121212"
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show Vertical Dividers",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider Line Color",
      "default": "#e5e5e5"
    },
    {
      "type": "header",
      "content": "Dimensions & Sizing"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Size (px)",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size (px)",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "page-width", "label": "Page Width" },
        { "value": "full-width", "label": "Full Width" }
      ],
      "default": "full-width"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Preset Icon",
          "options": [
            { "value": "feather_fabric", "label": "High Quality Fabrics (Feather)" },
            { "value": "badge_star", "label": "Handmade Fairly (Rosette Badge)" },
            { "value": "stretch", "label": "4-Way Stretch (Diamond)" },
            { "value": "hand_diamond", "label": "Original Swiss Artwork (Hand & Diamond)" },
            { "value": "leaf", "label": "Eco / Leaf" },
            { "value": "shield", "label": "Protection / Shield" }
          ],
          "default": "feather_fabric"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Icon Image"
        },
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Custom SVG Code"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon Features Bar",
      "settings": {
        "bg_color": "#f8f8f8",
        "text_color": "#121212",
        "icon_color": "#121212",
        "show_dividers": true,
        "icon_size": 38,
        "font_size": 15,
        "padding_top": 36,
        "padding_bottom": 36
      },
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "feather_fabric",
            "title": "High Quality Fabrics"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "badge_star",
            "title": "Handmade Fairly In Bali"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "stretch",
            "title": "4 Way Stretch Cotton"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "hand_diamond",
            "title": "Original Swiss Artwork"
          }
        }
      ]
    }
  ]
}
{% endschema %}
