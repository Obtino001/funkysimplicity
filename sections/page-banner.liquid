
{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section page-banner{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}{% if section.settings.background_image != blank %} page-banner--has-image{% endif %}"
  style="
    --padding-block-start: {{ section.settings.padding_block_start }}px;
    --padding-block-end: {{ section.settings.padding_block_end }}px;
    --banner-min-height: {{ section.settings.min_height }}px;
  "
>
  {%- if section.settings.background_image != blank -%}
    <div class="page-banner__image-wrapper">
      {{
        section.settings.background_image
        | image_url: width: 2000
        | image_tag: loading: 'eager', fetchpriority: 'high', class: 'page-banner__image', sizes: '100vw'
      }}
    </div>
  {%- endif -%}

  <div class="page-banner__content page-banner__content--{{ section.settings.text_alignment }}">
    {%- if section.settings.show_breadcrumb -%}
      <nav class="page-banner__breadcrumb" aria-label="breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">/</span>
        <span>{{ page_title | default: section.settings.heading }}</span>
      </nav>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="page-banner__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <div class="page-banner__subtext rte">{{ section.settings.subtext }}</div>
    {%- endif -%}
  </div>
</div>

<style>
  .page-banner {
    position: relative;
    padding-block-start: var(--padding-block-start, 48px);
    padding-block-end: var(--padding-block-end, 32px);
    min-height: var(--banner-min-height, auto);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .page-banner__image-wrapper {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .page-banner__content {
    position: relative;
    z-index: 1;
    max-width: 750px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .page-banner__content--left {
    align-items: flex-start;
    text-align: left;
    margin-inline: 0;
  }

  .page-banner__content--center {
    align-items: center;
    text-align: center;
  }

  .page-banner--has-image .page-banner__heading,
  .page-banner--has-image .page-banner__subtext,
  .page-banner--has-image .page-banner__breadcrumb {
    color: rgb(var(--color-background, 255, 255, 255));
  }

  .page-banner__breadcrumb {
    display: flex;
    gap: 6px;
    font-size: 1.2rem;
    opacity: 0.7;
  }

  .page-banner__breadcrumb a {
    text-decoration: none;
    color: inherit;
  }

  .page-banner__heading {
    font-size: 46px;
    line-height: 50px;
    font-weight:400;
    margin: 0;
  }

  .page-banner__subtext {
    font-size: 18px;
    line-height: 24px;
    font-family: 'DM Sans';
    font-weight:400;
  }
  div#shopify-section-template--30252635423047__page_banner_RgWYDE {
    width: 1440px;
    margin: auto;
    padding-top: 60px;
}


  @media screen and (max-width: 749px) {
    .page-banner__heading {
      font-size: 36px;
      line-height: 1.15;
    }

    .page-banner__subtext {
      font-size: 14px;
    }
    .page-banner__content{
    padding: 0px 10px;
    }
    .section.page-banner {
    padding: 30px 0px;
}
.page-banner__content {
    max-width: 100%;
}
div#shopify-section-template--30252635423047__page_banner_WGKNcm .section.page-banner {
    padding: 60px 0;
}
}
</style>

{% schema %}
{
  "name": "Page banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About Us"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": false
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Used when no background image is set",
      "placeholder": "Default"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 0,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Page banner"
    }
  ]
}
{% endschema %}
