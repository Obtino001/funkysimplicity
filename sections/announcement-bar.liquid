<!-- sections/announcement-bar.liquid -->
{% comment %}
  Announcement Bar Section for Horizon Theme
  Matches: Free shipping banner with icon
{% endcomment %}

{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.background_color
  assign text_color = section.settings.text_color
  assign font_size = section.settings.font_size
  assign padding_y = section.settings.padding_y
  assign icon_width = section.settings.icon_width
  assign icon_color = section.settings.icon_color
  assign text = section.settings.text
  assign bg_opacity = section.settings.background_opacity | divided_by: 100.0
  assign link = section.settings.link
  assign show_icon = section.settings.show_icon
  assign icon_style = section.settings.icon_style
  assign text_alignment = section.settings.text_alignment
  assign font_weight = section.settings.font_weight
  assign letter_spacing = section.settings.letter_spacing
  assign border_bottom = section.settings.border_bottom
  assign border_bottom_color = section.settings.border_bottom_color
  assign border_bottom_width = section.settings.border_bottom_width
  assign animation = section.settings.animation
  assign closeable = section.settings.closeable
  assign show_on_home_only = section.settings.show_on_home_only
  assign show_on_product_only = section.settings.show_on_product_only
  assign show_on_collection_only = section.settings.show_on_collection_only
  assign show_on_pages = section.settings.show_on_pages
  assign schedule_enabled = section.settings.schedule_enabled
  assign schedule_start = section.settings.schedule_start
  assign schedule_end = section.settings.schedule_end
  assign sticky_header_offset = section.settings.sticky_header_offset
  assign mobile_font_size = section.settings.mobile_font_size
  assign mobile_padding_y = section.settings.mobile_padding_y
  assign hide_on_mobile = section.settings.hide_on_mobile
  assign hide_on_desktop = section.settings.hide_on_desktop
  assign marquee_enabled = section.settings.marquee_enabled
  assign marquee_speed = section.settings.marquee_speed
  assign marquee_direction = section.settings.marquee_direction
  assign marquee_pause_on_hover = section.settings.marquee_pause_on_hover

  if show_on_home_only and template != 'index'
    assign show_section = false
  elsif show_on_product_only and template != 'product'
    assign show_section = false
  elsif show_on_collection_only and template != 'collection'
    assign show_section = false
  elsif show_on_pages != blank
    assign current_handle = page.handle | default: collection.handle | default: product.handle
    assign allowed_pages = show_on_pages | split: ','
    assign show_section = false
    for allowed in allowed_pages
      assign trimmed = allowed | strip
      if trimmed == current_handle
        assign show_section = true
        break
      endif
    endfor
  else
    assign show_section = true
  endif

  if schedule_enabled
    assign now = 'now' | date: '%Y-%m-%dT%H:%M'
    if schedule_start != blank and now < schedule_start
      assign show_section = false
    endif
    if schedule_end != blank and now > schedule_end
      assign show_section = false
    endif
  endif
-%}

{%- if show_section -%}
  {%- unless hide_on_mobile and request.design_mode == false -%}
    <div
      id="AnnouncementBar-{{ section_id }}"
      class="announcement-bar{% if closeable %} announcement-bar--closeable{% endif %}{% if marquee_enabled %} announcement-bar--marquee{% endif %}{% if hide_on_mobile %} hidden md:block{% endif %}{% if hide_on_desktop %} md:hidden{% endif %}"
      style="
        --announcement-bg: {{ bg_color }};
        --announcement-text: {{ text_color }};
        --announcement-icon: {{ icon_color }};
        --announcement-font-size: {{ font_size }}px;
        --announcement-mobile-font-size: {{ mobile_font_size }}px;
        --announcement-padding-y: {{ padding_y }}px;
        --announcement-mobile-padding-y: {{ mobile_padding_y }}px;
        --announcement-icon-width: {{ icon_width }}px;
        --announcement-letter-spacing: {{ letter_spacing }}em;
        --announcement-border-bottom: {{ border_bottom_width }}px solid {{ border_bottom_color }};
        --marquee-speed: {{ marquee_speed }}s;
        --announcement-bg-opacity: {{ bg_opacity }};
      "
      data-section-id="{{ section_id }}"
      data-animation="{{ animation }}"
      data-marquee="{{ marquee_enabled }}"
      data-marquee-direction="{{ marquee_direction }}"
      data-marquee-pause="{{ marquee_pause_on_hover }}"
    >
      {%- if border_bottom -%}
        <div class="announcement-bar__border"></div>
      {%- endif -%}

      {%- if closeable -%}
        <button
          type="button"
          class="announcement-bar__close"
          aria-label="{{ 'accessibility.close' | t }}"
          onclick="this.closest('.announcement-bar').style.display='none'; localStorage.setItem('announcementClosed-{{ section_id }}', 'true');"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M13 1L1 13M1 1L13 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      {%- endif -%}

      {%- if link != blank and marquee_enabled == false -%}
        <a href="{{ link }}" class="announcement-bar__link">
      {%- endif -%}

      <div class="announcement-bar__content announcement-bar__content--{{ text_alignment }}">
        {%- if marquee_enabled -%}
          <div class="announcement-bar__marquee-wrapper">
            <div class="announcement-bar__marquee">
              {%- for i in (1..10) -%}
                <span class="announcement-bar__item">
                  {%- if show_icon -%}
                    <span class="announcement-bar__icon">
                      {%- case icon_style -%}
                        {%- when 'truck' -%}
                          <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M10 17H6V13H2V8C2 6.89543 2.89543 6 4 6H10V17Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M10 17H14V6H10V17Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M14 13H18L21 16V17H14V13Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="7" cy="17" r="1.5" stroke="currentColor" stroke-width="1.5"/>
                            <circle cx="17" cy="17" r="1.5" stroke="currentColor" stroke-width="1.5"/>
                          </svg>
                        {%- when 'truck_fast' -%}
                          <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M13 17H4V12H2L4 6H11V17Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M11 12H14L17 15V17H13V12Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="6.5" cy="17" r="1.5" stroke="currentColor" stroke-width="1.5"/>
                            <circle cx="15.5" cy="17" r="1.5" stroke="currentColor" stroke-width="1.5"/>
                            <path d="M18 9H22M20 7L20 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                          </svg>
                        {%- when 'box' -%}
                          <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 3L20 7.5V16.5L12 21L4 16.5V7.5L12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M12 12L20 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M12 12V21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M12 12L4 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        {%- when 'gift' -%}
                          <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="3" y="11" width="18" height="10" rx="1" stroke="currentColor" stroke-width="1.5"/>
                            <path d="M12 11V21" stroke="currentColor" stroke-width="1.5"/>
                            <path d="M3 11L12 3L21 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M8 3C8 3 6 5 6 7C6 9 8 11 10 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            <path d="M16 3C16 3 18 5 18 7C18 9 16 11 14 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                          </svg>
                        {%- when 'tag' -%}
                          <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M4.5 4.5L12 2L22 12L12 22L2 12L4.5 4.5Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="9" cy="9" r="1.5" stroke="currentColor" stroke-width="1.5"/>
                          </svg>
                        {%- when 'percent' -%}
                          <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
                            <path d="M9 9L15 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            <circle cx="9" cy="9" r="1" fill="currentColor"/>
                            <circle cx="15" cy="15" r="1" fill="currentColor"/>
                          </svg>
                        {%- when 'star' -%}
                          <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2L14.4 9.2H22L16 13.8L18.4 21L12 16.4L5.6 21L8 13.8L2 9.2H9.6L12 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                          </svg>
                        {%- when 'check' -%}
                          <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
                            <path d="M8 12L11 15L16 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        {%- when 'info' -%}
                          <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
                            <path d="M12 8V9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <path d="M12 12V16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                          </svg>
                        {%- when 'custom' -%}
                          {%- if section.settings.custom_icon_svg != blank -%}
                            {{ section.settings.custom_icon_svg }}
                          {%- else -%}
                            <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
                              <path d="M12 8V9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                              <path d="M12 12V16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                          {%- endif -%}
                        {%- endcase -%}
                    </span>
                  {%- endif -%}
                  <span class="announcement-bar__text" style="font-weight: {{ font_weight }};">{{ text }}</span>
                  {%- if link != blank -%}
                    <span class="announcement-bar__arrow">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M2.5 7H11.5M11.5 7L7.5 3M11.5 7L7.5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  {%- endif -%}
                </span>
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          {%- if show_icon -%}
            <span class="announcement-bar__icon">
              {%- case icon_style -%}
                {%- when 'truck' -%}
                  <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 17H6V13H2V8C2 6.89543 2.89543 6 4 6H10V17Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M10 17H14V6H10V17Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M14 13H18L21 16V17H14V13Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="7" cy="17" r="1.5" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="17" cy="17" r="1.5" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                {%- when 'truck_fast' -%}
                  <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M13 17H4V12H2L4 6H11V17Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M11 12H14L17 15V17H13V12Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="6.5" cy="17" r="1.5" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="15.5" cy="17" r="1.5" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M18 9H22M20 7L20 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                {%- when 'box' -%}
                  <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 3L20 7.5V16.5L12 21L4 16.5V7.5L12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M12 12L20 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M12 12V21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M12 12L4 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- when 'gift' -%}
                  <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="3" y="11" width="18" height="10" rx="1" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M12 11V21" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M3 11L12 3L21 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M8 3C8 3 6 5 6 7C6 9 8 11 10 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M16 3C16 3 18 5 18 7C18 9 16 11 14 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                {%- when 'tag' -%}
                  <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4.5 4.5L12 2L22 12L12 22L2 12L4.5 4.5Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="9" cy="9" r="1.5" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                {%- when 'percent' -%}
                  <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M9 9L15 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <circle cx="9" cy="9" r="1" fill="currentColor"/>
                    <circle cx="15" cy="15" r="1" fill="currentColor"/>
                  </svg>
                {%- when 'star' -%}
                  <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2L14.4 9.2H22L16 13.8L18.4 21L12 16.4L5.6 21L8 13.8L2 9.2H9.6L12 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                  </svg>
                {%- when 'check' -%}
                  <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M8 12L11 15L16 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- when 'info' -%}
                  <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M12 8V9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="M12 12V16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                {%- when 'custom' -%}
                  {%- if section.settings.custom_icon_svg != blank -%}
                    {{ section.settings.custom_icon_svg }}
                  {%- else -%}
                    <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M12 8V9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      <path d="M12 12V16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  {%- endif -%}
                {%- endcase -%}
            </span>
          {%- endif -%}
          <span class="announcement-bar__text" style="font-weight: {{ font_weight }};">{{ text }}</span>
          {%- if link != blank -%}
            <span class="announcement-bar__arrow">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2.5 7H11.5M11.5 7L7.5 3M11.5 7L7.5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- if link != blank and marquee_enabled == false -%}
        </a>
      {%- endif -%}
    </div>

    <style>
      .announcement-bar {
  position: relative;
  background-color: transparent;
  color: var(--announcement-text);
  overflow: hidden;
  z-index: 50;
}

      .announcement-bar__border {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: var(--announcement-border-bottom);
        background: var(--announcement-border-bottom);
      }

      .announcement-bar--closeable {
        padding-right: 40px;
      }




.announcement-bar::before {
  content: '';
  position: absolute;
  inset: 0;
  background-color: var(--announcement-bg);
  opacity: var(--announcement-bg-opacity);
  z-index: -1;
}

      .announcement-bar__close {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: var(--announcement-text);
        cursor: pointer;
        padding: 4px;
        opacity: 0.6;
        transition: opacity 0.2s;
        z-index: 10;
      }

      .announcement-bar__close:hover {
        opacity: 1;
      }

      .announcement-bar__link {
        display: block;
        text-decoration: none;
        color: inherit;
        transition: opacity 0.2s;
      }

      .announcement-bar__link:hover {
        opacity: 0.8;
      }

      .announcement-bar__content {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: var(--announcement-padding-y) 16px;
        font-size: var(--announcement-font-size);
        line-height: 1.4;
        letter-spacing: var(--announcement-letter-spacing);
        min-height: 36px;
      }

      .announcement-bar__content--left {
        justify-content: flex-start;
      }

      .announcement-bar__content--center {
        justify-content: center;
      }

      .announcement-bar__content--right {
        justify-content: flex-end;
      }

      .announcement-bar__icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: var(--announcement-icon-width);
        height: var(--announcement-icon-width);
        color: var(--announcement-icon);
      }

      .announcement-bar__text {
        display: inline;
      }

      .announcement-bar__arrow {
        display: inline-flex;
        align-items: center;
        margin-left: 2px;
        opacity: 0.7;
      }

      /* Marquee Styles */
      .announcement-bar--marquee .announcement-bar__content {
        padding: 0;
      }

      .announcement-bar__marquee-wrapper {
        width: 100%;
        overflow: hidden;
        padding: var(--announcement-padding-y) 0;
      }

      .announcement-bar__marquee {
        display: flex;
        width: max-content;
        animation: marquee-scroll var(--marquee-speed) linear infinite;
      }

      .announcement-bar[data-marquee-direction="right"] .announcement-bar__marquee {
        animation-direction: reverse;
      }

      .announcement-bar[data-marquee-pause="true"]:hover .announcement-bar__marquee {
        animation-play-state: paused;
      }

      .announcement-bar__item {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 0 40px;
        white-space: nowrap;
        flex-shrink: 0;
      }

      @keyframes marquee-scroll {
        0% {
          transform: translateX(0);
        }
        100% {
          transform: translateX(-50%);
        }
      }

      /* Animation: Fade In */
      .announcement-bar[data-animation="fade_in"] {
        animation: announcement-fade-in 0.6s ease-out;
      }

      @keyframes announcement-fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      /* Animation: Slide Down */
      .announcement-bar[data-animation="slide_down"] {
        animation: announcement-slide-down 0.5s ease-out;
      }

      @keyframes announcement-slide-down {
        from { transform: translateY(-100%); }
        to { transform: translateY(0); }
      }

      /* Animation: Slide Up */
      .announcement-bar[data-animation="slide_up"] {
        animation: announcement-slide-up 0.5s ease-out;
      }

      @keyframes announcement-slide-up {
        from { transform: translateY(100%); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
      }

      /* Animation: Scale */
      .announcement-bar[data-animation="scale"] {
        animation: announcement-scale 0.4s ease-out;
      }

      @keyframes announcement-scale {
        from { transform: scale(0.95); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
      }

      /* Mobile */
      @media (max-width: 767px) {
        .announcement-bar__content {
          font-size: var(--announcement-mobile-font-size);
          padding: var(--announcement-mobile-padding-y) 12px;
        }

        .announcement-bar--closeable {
          padding-right: 36px;
        }

        .announcement-bar__close {
          right: 8px;
        }

        .announcement-bar__item {
          padding: 0 24px;
        }
      }

      /* Hidden utilities */
      .hidden {
        display: none !important;
      }

      @media (min-width: 768px) {
        .md\:block {
          display: block !important;
        }
        .md\:hidden {
          display: none !important;
        }
      }
    </style>

    <script>
      (function() {
        var sectionId = '{{ section_id }}';
        var closed = localStorage.getItem('announcementClosed-' + sectionId);
        if (closed === 'true') {
          var bar = document.getElementById('AnnouncementBar-' + sectionId);
          if (bar) bar.style.display = 'none';
        }
      })();
    </script>
  {%- endunless -%}
{%- endif -%}

