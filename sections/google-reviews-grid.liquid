{%- comment -%}
  Google Customer Reviews Grid / Marquee Section
  Features:
  - Header with title and "Rated 5/5 On Google Reviews" image logo
  - Dual-row review cards with smooth fade edges and optional auto-scrolling marquee
  - Self-contained HTML inside loops (No external snippets needed)
{%- endcomment -%}

{%- liquid
  assign section_id = section.id
  assign heading = section.settings.heading
  assign heading_size = section.settings.heading_size | default: 'h2'
  assign rating_prefix = section.settings.rating_prefix | default: 'Rated 5/5 On'
  assign google_logo = section.settings.google_logo
  assign enable_marquee = section.settings.enable_marquee
  assign marquee_speed = section.settings.marquee_speed | default: 35
  assign show_view_all = section.settings.show_view_all
  assign view_all_text = section.settings.view_all_text | default: 'VIEW ALL REVIEWS'
  assign view_all_link = section.settings.view_all_link | default: '#'
  assign card_bg = section.settings.card_bg | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#121212'
  assign star_color = section.settings.star_color | default: '#f59e0b'
  assign padding_top = section.settings.padding_top | default: 64
  assign padding_bottom = section.settings.padding_bottom | default: 64
-%}

<section
  id="GoogleReviews-{{ section_id }}"
  class="google-reviews-section section-{{ section_id }}"
  style="
    --gr-card-bg: {{ card_bg }};
    --gr-text-color: {{ text_color }};
    --gr-star-color: {{ star_color }};
    --gr-marquee-speed: {{ marquee_speed }}s;
    --gr-padding-top: {{ padding_top }}px;
    --gr-padding-bottom: {{ padding_bottom }}px;
  "
>
  <div class="gr-container">
    {%- comment -%} SECTION HEADER {%- endcomment -%}
    <div class="gr-header">
      {%- if heading != blank -%}
        <h2 class="gr-heading {{ heading_size }}">{{ heading }}</h2>
      {%- endif -%}

      <div class="gr-rating-badge">
        {%- if rating_prefix != blank -%}
          <span class="gr-rating-text">{{ rating_prefix }}</span>
        {%- endif -%}

        {%- if google_logo != blank -%}
          <img src="{{ google_logo | image_url: width: 150 }}" alt="Google Reviews" class="gr-google-logo-img" loading="lazy">
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} REVIEWS ROWS / TRACKS {%- endcomment -%}
    {%- liquid
      assign total_blocks = section.blocks.size
      assign half_count = total_blocks | divided_by: 2
      if total_blocks == 0
        assign half_count = 3
      endif
    -%}

    <div class="gr-tracks-wrapper">
      <div class="gr-fade gr-fade--left"></div>
      <div class="gr-fade gr-fade--right"></div>

      {%- comment -%} ROW 1 {%- endcomment -%}
      <div class="gr-track-row{% if enable_marquee %} gr-marquee gr-marquee--left{% endif %}">
        <div class="gr-track-inner">
          {%- if total_blocks > 0 -%}
            {%- for block in section.blocks limit: half_count -%}
              <div class="gr-card" {{ block.shopify_attributes }}>
                <div class="gr-card__header">
                  <div class="gr-card__avatar" style="background-color: {{ block.settings.avatar_color }}">
                    {%- if block.settings.avatar_image != blank -%}
                      <img src="{{ block.settings.avatar_image | image_url: width: 100 }}" alt="{{ block.settings.author }}" loading="lazy">
                    {%- else -%}
                      {{ block.settings.author | slice: 0 | upcase }}
                    {%- endif -%}
                    
                    {%- if block.settings.show_google_badge -%}
                      <div class="gr-card__google-badge">
                        <svg viewBox="0 0 24 24" aria-label="Google">
                          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                        </svg>
                      </div>
                    {%- endif -%}
                  </div>
                  
                  <div class="gr-card__meta">
                    <h3 class="gr-card__author">{{ block.settings.author }}</h3>
                    <div class="gr-card__stars">
                      {%- for i in (1..block.settings.rating) -%}
                        <svg class="gr-star" viewBox="0 0 20 20" fill="currentColor">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                      {%- endfor -%}
                    </div>
                  </div>
                </div>
                
                <p class="gr-card__text">{{ block.settings.text }}</p>
                <div class="gr-card__date">{{ block.settings.date }}</div>
              </div>
            {%- endfor -%}
            
            {%- if enable_marquee -%}
              {%- for block in section.blocks limit: half_count -%}
                <div class="gr-card" {{ block.shopify_attributes }}>
                  <div class="gr-card__header">
                    <div class="gr-card__avatar" style="background-color: {{ block.settings.avatar_color }}">
                      {%- if block.settings.avatar_image != blank -%}
                        <img src="{{ block.settings.avatar_image | image_url: width: 100 }}" alt="{{ block.settings.author }}" loading="lazy">
                      {%- else -%}
                        {{ block.settings.author | slice: 0 | upcase }}
                      {%- endif -%}
                      
                      {%- if block.settings.show_google_badge -%}
                        <div class="gr-card__google-badge">
                          <svg viewBox="0 0 24 24" aria-label="Google">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                          </svg>
                        </div>
                      {%- endif -%}
                    </div>
                    
                    <div class="gr-card__meta">
                      <h3 class="gr-card__author">{{ block.settings.author }}</h3>
                      <div class="gr-card__stars">
                        {%- for i in (1..block.settings.rating) -%}
                          <svg class="gr-star" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                          </svg>
                        {%- endfor -%}
                      </div>
                    </div>
                  </div>
                  
                  <p class="gr-card__text">{{ block.settings.text }}</p>
                  <div class="gr-card__date">{{ block.settings.date }}</div>
                </div>
              {%- endfor -%}
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} ROW 2 {%- endcomment -%}
      <div class="gr-track-row{% if enable_marquee %} gr-marquee gr-marquee--right{% endif %}">
        <div class="gr-track-inner">
          {%- if total_blocks > 0 -%}
            {%- for block in section.blocks offset: half_count -%}
              <div class="gr-card" {{ block.shopify_attributes }}>
                <div class="gr-card__header">
                  <div class="gr-card__avatar" style="background-color: {{ block.settings.avatar_color }}">
                    {%- if block.settings.avatar_image != blank -%}
                      <img src="{{ block.settings.avatar_image | image_url: width: 100 }}" alt="{{ block.settings.author }}" loading="lazy">
                    {%- else -%}
                      {{ block.settings.author | slice: 0 | upcase }}
                    {%- endif -%}
                    
                    {%- if block.settings.show_google_badge -%}
                      <div class="gr-card__google-badge">
                        <svg viewBox="0 0 24 24" aria-label="Google">
                          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                        </svg>
                      </div>
                    {%- endif -%}
                  </div>
                  
                  <div class="gr-card__meta">
                    <h3 class="gr-card__author">{{ block.settings.author }}</h3>
                    <div class="gr-card__stars">
                      {%- for i in (1..block.settings.rating) -%}
                        <svg class="gr-star" viewBox="0 0 20 20" fill="currentColor">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
