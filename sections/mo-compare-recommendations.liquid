<div
  class="mo-compare-recommendations"
  data-mo-compare-recommendations
>
  {% if recommendations.performed? and recommendations.products_count > 0 %}

    <h2 class="mo-compare-recommendations__title">
      Compare Your Style
    </h2>

    <div class="mo-compare-recommendations__products">

      {% for recommended_product in recommendations.products limit: 8 %}

        <div class="mo-compare-recommendations__item{% if forloop.index > 3 %} is-extra{% endif %}">
          {% render 'mo-compare-product',
            product: recommended_product
          %}
        </div>

      {% endfor %}

    </div>

    {% if recommendations.products_count > 3 %}
      <button type="button" class="mo-compare-recommendations__more" data-mo-compare-more aria-expanded="false">
        <span data-label-more>Show more</span>
        <span data-label-less hidden>Show less</span>
      </button>
    {% endif %}

  {% endif %}
</div>

{% schema %}
{
  "name": "Mo Compare Product",
  "settings": []
}
{% endschema %}
