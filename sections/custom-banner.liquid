{%- liquid
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: desktop_image
  assign image_alt = desktop_image.alt | default: section.settings.heading
-%}

<section
  id="CustomBanner-{{ section.id }}"
  class="custom-banner"
  style="
    --banner-height: {{ section.settings.desktop_height }}px;
    --banner-height-mobile: {{ section.settings.mobile_height }}px;
    --banner-content-x: {{ section.settings.content_x }}%;
    --banner-content-y: {{ section.settings.content_y }}%;
    --banner-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --banner-text-color: {{ section.settings.text_color }};
  "
>
  <div class="custom-banner__media">
    {%- if desktop_image != blank -%}
      <picture>
        {%- if section.settings.mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_image | image_url: width: 480 }} 480w,
              {{ mobile_image | image_url: width: 750 }} 750w,
              {{ mobile_image | image_url: width: 1000 }} 1000w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          desktop_image
          | image_url: width: 2560
          | image_tag:
            class: 'custom-banner__image',
            widths: '750, 1200, 1440, 1920, 2560',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: image_alt
        }}
      </picture>
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'custom-banner__image custom-banner__placeholder' }}
    {%- endif -%}
    <span class="custom-banner__overlay" aria-hidden="true"></span>
  </div>

  <div class="custom-banner__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="custom-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="custom-banner__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
      <div class="custom-banner__actions">
        {%- if section.settings.primary_label != blank -%}
          <a
            class="custom-banner__button custom-banner__button--primary"
            href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}"
          >
            {{- section.settings.primary_label | escape -}}
          </a>
        {%- endif -%}

        {%- if section.settings.secondary_label != blank -%}
          <a
            class="custom-banner__button custom-banner__button--secondary"
            href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}"
          >
            {{- section.settings.secondary_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .custom-banner {
    position: relative;
    width: 100%;
    height: var(--banner-height);
    min-height: var(--banner-height);
    overflow: hidden;
    isolation: isolate;
    color: var(--banner-text-color, #ffffff);
  }

  .custom-banner__media,
  .custom-banner__media picture,
  .custom-banner__image,
  .custom-banner__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .custom-banner__media picture,
  .custom-banner__image {
    display: block;
  }

  .custom-banner__image {
    object-fit: cover;
    object-position: center;
  }

  .custom-banner__placeholder {
    background: #2c9ed9;
  }

  .custom-banner__overlay {
    z-index: 1;
    background: #000000;
    opacity: var(--banner-overlay-opacity, 0);
    pointer-events: none;
  }

  .custom-banner__content {
    position: absolute;
    z-index: 2;
    top: var(--banner-content-y);
    left: var(--banner-content-x);
    width: min(623px, calc(100% - 48px));
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    color: inherit;
    text-align: center;
  }

  .custom-banner__eyebrow {
    margin: 0;
    font-family: var(--font-body--family, sans-serif);
    font-size: 14px;
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
  }

  .custom-banner__heading {
    max-width: 623px;
    margin: 0;
    color: inherit;
    font-family: var(--font-heading--family, serif);
    font-size: 46px;
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .custom-banner__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 2px;
  }

  .custom-banner__button {
    display: inline-flex;
    min-width: 150px;
    min-height: 48px;
    padding: 12px 24px;
    border: 1px solid #ffffff;
    border-radius: 999px;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    font-family: var(--font-body--family, sans-serif);
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    color: #ffffff;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .custom-banner__button--primary {
    color: #111111;
    background: #ffffff;
  }

  .custom-banner__button--secondary {
    background: rgb(255 255 255 / 0.2);
  }

  .custom-banner__button--primary:hover {
    color: #ffffff;
    background: #111111;
    border-color: #111111;
  }

  .custom-banner__button--secondary:hover {
    color: #111111;
    background: #ffffff;
  }

  @media screen and (max-width: 749px) {
    .custom-banner {
      height: var(--banner-height-mobile);
      min-height: var(--banner-height-mobile);
    }

    .custom-banner__image {
      object-position: center top;
    }

    .custom-banner__content {
      top: 50%;
      left: 50%;
      width: calc(100% - 32px);
      gap: 12px;
    }

    .custom-banner__eyebrow {
      font-size: 10px;
    }

    .custom-banner__heading {
      max-width: 340px;
      font-size: 24px;
      line-height: 1.12;
    }

    .custom-banner__actions {
      gap: 8px;
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom banner",
  "tag": "div",
  "class": "custom-banner-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 500,
      "max": 1000,
      "step": 5,
      "unit": "px",
      "default": 705
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 500,
      "max": 900,
      "step": 5,
      "unit": "px",
      "default": 735
    },
    {
      "type": "range",
      "id": "content_x",
      "label": "Desktop content horizontal position",
      "min": 20,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "content_y",
      "label": "Desktop content vertical position",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 52
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "HANDMADE IN BALI SINCE 1994"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Timeless Cotton Active Wear Made With Soul"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "SHOP BY PRINTS"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Custom banner"
    }
  ]
}
{% endschema %}
