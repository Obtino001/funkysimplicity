{%- comment -%}
  Hero Feature Boxes Banner Section
{%- endcomment -%}

{%- liquid
  assign section_id = section.id
  assign bg_image = section.settings.image
  assign bg_image_mobile = section.settings.image_mobile | default: bg_image
  assign overlay_color = section.settings.overlay_color | default: '#000000'
  assign overlay_opacity = section.settings.overlay_opacity | default: 20
  assign heading = section.settings.heading
  assign heading_size = section.settings.heading_size | default: 56
  assign heading_max_width = section.settings.heading_max_width | default: 560
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign box_border_color = section.settings.box_border_color | default: '#ffffff'
  assign box_border_opacity = section.settings.box_border_opacity | default: 40
  assign box_bg_opacity = section.settings.box_bg_opacity | default: 8
  assign section_min_height = section.settings.section_min_height | default: '700px'
  assign padding_top = section.settings.padding_top | default: 60
  assign padding_bottom = section.settings.padding_bottom | default: 60
-%}

<section
  id="HeroFeatureBoxes-{{ section_id }}"
  class="hero-feature-boxes section-{{ section_id }}"
  style="
    --hfb-text-color: {{ text_color }};
    --hfb-overlay-color: {{ overlay_color }};
    --hfb-overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }};
    --hfb-box-border: {{ box_border_color }}{{ box_border_opacity | times: 2.55 | round | format: '%02x' }};
    --hfb-box-bg: rgba(255, 255, 255, {{ box_bg_opacity | divided_by: 100.0 }});
    --hfb-heading-size: {{ heading_size }}px;
    --hfb-heading-max-width: {{ heading_max_width }}px;
    --hfb-min-height: {{ section_min_height }};
    --hfb-padding-top: {{ padding_top }}px;
    --hfb-padding-bottom: {{ padding_bottom }}px;
  "
>
  {%- comment -%} Background Image & Overlay {%- endcomment -%}
  <div class="hfb-bg">
    {%- if bg_image != blank -%}
      <picture>
        {%- if bg_image_mobile != blank and bg_image_mobile != bg_image -%}
          <source media="(max-width: 749px)" srcset="{{ bg_image_mobile | image_url: width: 1000 }}">
        {%- endif -%}
        <img
          src="{{ bg_image | image_url: width: 2400 }}"
          alt="{{ bg_image.alt | default: heading | escape }}"
          class="hfb-bg__image"
          loading="lazy"
          width="2400"
          height="1400"
        >
      </picture>
    {%- else -%}
      <div class="hfb-bg__placeholder"></div>
    {%- endif -%}
    <div class="hfb-bg__overlay"></div>
  </div>

  <div class="hfb-container">
    {%- comment -%} Main Heading {%- endcomment -%}
    <div class="hfb-header">
      {%- if heading != blank -%}
        <h2 class="hfb-heading">
          {{ heading | newline_to_br }}
        </h2>
      {%- endif -%}
    </div>

    {%- comment -%} 4 Feature Boxes Grid / Swiper {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="hfb-slider-wrapper">
        <div class="hfb-grid">
          {%- for block in section.blocks -%}
            <div class="hfb-box" {{ block.shopify_attributes }}>
              <div class="hfb-box__icon-wrap">
                {%- if block.settings.custom_svg != blank -%}
                  <div class="hfb-box__svg">
                    {{ block.settings.custom_svg }}
                  </div>
                {%- elsif block.settings.custom_image != blank -%}
                  <img
                    src="{{ block.settings.custom_image | image_url: width: 120 }}"
                    alt="{{ block.settings.title | escape }}"
                    class="hfb-box__icon-img"
                    width="51"
                    height="49"
                    loading="lazy"
                  >
                {%- else -%}
                  {%- case block.settings.icon -%}
                    {%- when 'stretch' -%}
                      <svg class="hfb-box__icon-svg" viewBox="0 0 51 49" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4.5 4.5C12 12 12 37 4.5 44.5C12 37 39 37 46.5 44.5C39 37 39 12 46.5 4.5C39 12 12 12 4.5 4.5Z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M25.5 17L28 22.5L33.5 24.5L28 26.5L25.5 32L23 26.5L17.5 24.5L23 22.5L25.5 17Z" fill="currentColor"/>
                        <path d="M16 19L19.5 15.5M16 19H19M16 19V16" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M35 19L31.5 15.5M35 19H32M35 19V16" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M16 30L19.5 33.5M16 30H19M16 30V33" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M35 30L31.5 33.5M35 30H32M35 30V33" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- when 'feather' -%}
                      <svg class="hfb-box__icon-svg" viewBox="0 0 51 49" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M42.5 6.5C33.5 6.5 16 13 13.5 29C13 32 10.5 35 7.5 37.5C14.5 38.5 20.5 36 24 32.5C38 18 42.5 6.5 42.5 6.5Z" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M13.5 29C20 25.5 29 18 35.5 12.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                        <path d="M21 29.5L25.5 32" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                        <path d="M26 23.5L32 25.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                      </svg>
                    {%- when 'needle_thread' -%}
                      <svg class="hfb-box__icon-svg" viewBox="0 0 51 49" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M37.5 7.5L12.5 39.5L10 41.5L12 39L24 24" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                        <line x1="34" y1="11" x2="36" y2="9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                        <path d="M36 9.5C39 6.5 44 8.5 42 13.5C39 21 27 21 29 27C31 33 39 31 40 37" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    {%- when 'fabric_layers' -%}
                      <svg class="hfb-box__icon-svg" viewBox="0 0 51 49" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M25.5 10.5L42.5 17.5L25.5 24.5L8.5 17.5L25.5 10.5Z" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="21" cy="16" r="1" fill="currentColor"/>
                        <circle cx="25.5" cy="14.5" r="1" fill="currentColor"/>
                        <circle cx="30" cy="16" r="1" fill="currentColor"/>
                        <circle cx="25.5" cy="18" r="1" fill="currentColor"/>
                        <circle cx="21" cy="19.5" r="1" fill="currentColor"/>
                        <circle cx="30" cy="19.5" r="1" fill="currentColor"/>
                        <path d="M8.5 23.5L25.5 30.5L42.5 23.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M8.5 29.5L25.5 36.5L42.5 29.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                  {%- endcase -%}
                {%- endif -%}
              </div>
  
              <h3 class="hfb-box__title">{{ block.settings.title }}</h3>
              <div class="hfb-box__desc">{{ block.settings.text }}</div>
            </div>
          {%- endfor -%}
        </div>
        
        {%- comment -%} Mobile Pagination Dots {%- endcomment -%}
        <div class="hfb-pagination">
          {%- for block in section.blocks -%}
            <button class="hfb-dot {% if forloop.first %}is-active{% endif %}" aria-label="Go to slide {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  /* 1. SECTION WRAPPER */
  .hero-feature-boxes {
    position: relative;
    width: 100%;
    min-height: var(--hfb-min-height, 700px);
    display: flex;
    flex-direction: column;
    color: var(--hfb-text-color, #ffffff);
    box-sizing: border-box;
    overflow: hidden;
  }

  /* 2. BACKGROUND */
  .hfb-bg { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; }
  .hfb-bg picture, .hfb-bg__image { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
  .hfb-bg__placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, #44372e 0%, #292019 100%); }
  .hfb-bg__overlay { position: absolute; inset: 0; background-color: var(--hfb-overlay-color, #000000); opacity: var(--hfb-overlay-opacity, 0.2); z-index: 2; }

  /* 3. MAIN CONTAINER (Desktop Default) */
  .hfb-container {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    flex: 1; 
    display: flex;
    flex-direction: column;
    justify-content: flex-end; 
    padding-top: var(--hfb-padding-top, 60px);
    padding-bottom: var(--hfb-padding-bottom, 60px);
    padding-inline: 2rem;
  }

  /* 4. HEADER */
  .hfb-header {
    width: 100%;
    max-width: var(--hfb-heading-max-width, 560px);
  }
  .hfb-heading {
    margin: 0;
    color: inherit;
    font-family: 'Fraunces', var(--font-heading--family, serif);
    font-weight: 400;
    font-size: clamp(2.25rem, 4.5vw, var(--hfb-heading-size, 56px));
    line-height: 1.1;
    letter-spacing: 0;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.2);
  }

  /* 5. GRID / SLIDER (Desktop Default) */
  .hfb-slider-wrapper {
    width: 100%;
    margin-top: 40px;
  }
  .hfb-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    width: 100%;
  }
  .hfb-pagination { display: none; }

  /* 6. BOX STYLING (Desktop Default) */
  .hfb-box {
    position: relative;
    box-sizing: border-box;
    padding: 1.75rem 1.5rem 2rem;
    border: 1px solid var(--hfb-box-border, rgba(255, 255, 255, 0.5));
    background: var(--hfb-box-bg, rgba(255, 255, 255, 0.08));
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: left;
    transition: transform 0.3s ease;
  }
  .hfb-box__icon-wrap { width: 51px; height: 49px; display: flex; align-items: center; justify-content: flex-start; flex-shrink: 0; }
  .hfb-box__icon-svg, .hfb-box__svg svg, .hfb-box__icon-img { width: 51px; height: 49px; display: block; object-fit: contain; }
  .hfb-box__title { margin: 0; font-family: 'DM Sans', var(--font-body--family, sans-serif); font-size: 18px; font-weight: 700; line-height: 1.15; }
  .hfb-box__desc { margin: 0; font-family: 'DM Sans', var(--font-body--family, sans-serif); font-size: 16px; font-weight: 400; line-height: 1.4; opacity: 0.92; }

  @media screen and (max-width: 1024px) {
    .hfb-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* -------------------------------------------
     MOBILE ADJUSTMENTS (100% Match to Image 2)
  ------------------------------------------- */
  @media screen and (max-width: 749px) {
    .hero-feature-boxes {
      min-height: 100svh; /* Forces exact screen height */
      height: 100%;
    }
    
    .hfb-container {
      padding-inline: 0; 
      padding-top: 15vh; /* Pushes the title down slightly from the very top */
      padding-bottom: 6vh; /* Pushes slider up slightly from the bottom */
      
      /* Bulletproof Top/Bottom Split */
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 100svh;
    }

    .hfb-header {
      padding-inline: 20px;
      text-align: center;
      margin-inline: auto;
      margin-bottom: auto; /* Forces title to top */
    }
    
    .hfb-heading {
      font-size: clamp(2rem, 8vw, 2.75rem);
    }

    .hfb-slider-wrapper {
      margin-top: auto; /* Forces slider to bottom */
      width: 100%;
      overflow: hidden;
    }

    .hfb-grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none; 
      -ms-overflow-style: none;
      
      /* Exact Spacing to center card and show the peek */
      gap: 16px; 
      padding: 0 9vw; /* Centers the 82vw wide card perfectly */
    }
    
    .hfb-grid::-webkit-scrollbar { display: none; } 

    .hfb-box {
      /* Card width is exactly 82% of screen, leaving room for the next card to peek */
      flex: 0 0 82vw; 
      max-width: 350px;
      scroll-snap-align: center;
      padding: 2rem 1.5rem;
      
      /* Matching the Darker Glassmorphism perfectly */
      background: rgba(0, 0, 0, 0.45); 
      border: 1px solid rgba(255, 255, 255, 0.35);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    /* Pagination Dots matching image exactly */
    .hfb-pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      width: 100%;
      margin-top: 24px; /* Space between box and dots */
    }
    
    .hfb-dot {
      background-color: #ffffff;
      border: none;
      padding: 0;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      opacity: 0.5;
      transition: all 0.3s ease;
    }
    
    .hfb-dot.is-active {
      width: 28px; /* Longer pill shape */
      height: 6px;
      border-radius: 4px;
      opacity: 1;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('#HeroFeatureBoxes-{{ section_id }}');
    if (!section) return;
    
    const grid = section.querySelector('.hfb-grid');
    const boxes = section.querySelectorAll('.hfb-box');
    const dots = section.querySelectorAll('.hfb-dot');

    if (boxes.length > 0 && dots.length > 0 && window.innerWidth <= 749) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const index = Array.from(boxes).indexOf(entry.target);
            dots.forEach((dot, i) => {
              if (i === index) dot.classList.add('is-active');
              else dot.classList.remove('is-active');
            });
          }
        });
      }, {
        root: grid,
        threshold: 0.6
      });

      boxes.forEach(box => observer.observe(box));
    }
  });
</script>

{% schema %}
{
  "name": "Hero Feature Boxes",
  "class": "section-hero-feature-boxes",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Background Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Background Image (Optional)"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "header",
      "content": "Main Heading"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading Text",
      "default": "The Perfect Leggings\nFrom Our Bali Family",
      "info": "Use 'Enter' to create a line break"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size (px)",
      "min": 32,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "label": "Heading Max Width (px)",
      "min": 360,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Feature Boxes Style"
    },
    {
      "type": "color",
      "id": "box_border_color",
      "label": "Box Border Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "box_border_opacity",
      "label": "Box Border Opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "range",
      "id": "box_bg_opacity",
      "label": "Box Background Tint Opacity",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "%",
      "default": 8
    },
    {
      "type": "header",
      "content": "Section Dimensions & Padding"
    },
    {
      "type": "select",
      "id": "section_min_height",
      "label": "Section Minimum Height",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "600px", "label": "600px" },
        { "value": "700px", "label": "700px" },
        { "value": "800px", "label": "800px" },
        { "value": "100vh", "label": "Full Screen (100vh)" }
      ],
      "default": "700px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "feature_box",
      "name": "Feature Box",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Preset Icon (51x49)",
          "options": [
            { "value": "stretch", "label": "4-Way Stretch" },
            { "value": "feather", "label": "Buttery-Soft (Feather)" },
            { "value": "needle_thread", "label": "Balinese Craftsmanship (Needle)" },
            { "value": "fabric_layers", "label": "High Quality Fabrics (Layers)" }
          ],
          "default": "stretch"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Icon Image"
        },
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Custom SVG Code"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Box Title",
          "default": "Four Way Stretch Cotton"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Box Description",
          "default": "Made with our amazing 4-way stretch cotton, flexibility and support."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Feature Boxes",
      "settings": {
        "heading": "The Perfect Leggings\nFrom Our Bali Family"
      },
      "blocks": [
        { "type": "feature_box", "settings": { "icon": "stretch", "title": "Four Way Stretch Cotton", "text": "Made with our amazing 4-way stretch cotton, flexibility and support." } },
        { "type": "feature_box", "settings": { "icon": "feather", "title": "Buttery-Soft Comfort", "text": "Ultra-soft cotton stretch fabric that feels like a second skin." } },
        { "type": "feature_box", "settings": { "icon": "needle_thread", "title": "Balinese Craftsmanship", "text": "Lovingly handmade by skilled Balinese artisans, with each piece crafted with care and pride." } },
        { "type": "feature_box", "settings": { "icon": "fabric_layers", "title": "High Quality Fabrics", "text": "90% cotton and 10% elastane, made to last through countless washes and wears without losing shape." } }
      ]
    }
  ]
}
{% endschema %}