

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section page-banner-wide{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}{% if section.settings.background_image != blank or section.settings.background_image_mobile != blank %} page-banner-wide--has-image{% endif %}"
  style="
    --padding-block-start: {{ section.settings.padding_block_start }}px;
    --padding-block-end: {{ section.settings.padding_block_end }}px;
    --banner-min-height: {{ section.settings.min_height }}px;
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --heading-size: {{ section.settings.heading_size }}px;
    --heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --heading-weight: {{ section.settings.heading_weight }};
    --subtext-size: {{ section.settings.subtext_size }}px;
    --subtext-size-mobile: {{ section.settings.subtext_size_mobile }}px;
    --subtext-weight: {{ section.settings.subtext_weight }};
  "
>
  {%- if section.settings.background_image != blank or section.settings.background_image_mobile != blank -%}
    <div class="page-banner-wide__image-wrapper">
      {%- if section.settings.background_image != blank -%}
        {{
          section.settings.background_image
          | image_url: width: 2000
          | image_tag: loading: 'eager', fetchpriority: 'high', class: 'page-banner-wide__image page-banner-wide__image--desktop', sizes: '100vw'
        }}
      {%- endif -%}

      {%- liquid
        assign mobile_image = section.settings.background_image_mobile | default: section.settings.background_image
      -%}
      {%- if mobile_image != blank -%}
        {{
          mobile_image
          | image_url: width: 1200
          | image_tag: loading: 'eager', fetchpriority: 'high', class: 'page-banner-wide__image page-banner-wide__image--mobile', sizes: '100vw'
        }}
      {%- endif -%}

      {%- if section.settings.overlay_opacity > 0 -%}
        <div class="page-banner-wide__overlay"></div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="page-banner-wide__content page-banner-wide__content--{{ section.settings.text_alignment }}">
    {%- if section.settings.show_breadcrumb -%}
      <nav class="page-banner-wide__breadcrumb" aria-label="breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">/</span>
        <span>{{ page_title | default: section.settings.heading }}</span>
      </nav>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="page-banner-wide__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <div class="page-banner-wide__subtext rte">{{ section.settings.subtext }}</div>
    {%- endif -%}
  </div>
</div>

<style>
  div#shopify-section-template--30252635423047__page_banner_wide_fzQiD8 {
    width: 1440px;
    margin: auto;
    padding-top: 60px;
  }

  .page-banner-wide {
    position: relative;
    padding-block-start: var(--padding-block-start, 48px);
    padding-block-end: var(--padding-block-end, 32px);
    min-height: var(--banner-min-height, auto);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .page-banner-wide__image-wrapper {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-banner-wide__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .page-banner-wide__image--mobile {
    display: none;
  }

  .page-banner-wide__overlay {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / var(--overlay-opacity, 0.3));
  }

  .page-banner-wide__content {
    position: relative;
    z-index: 1;
    max-width: 750px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .page-banner-wide__content--left {
    align-items: flex-start;
    text-align: left;
    margin-inline: 0;
  }

  .page-banner-wide__content--center {
    align-items: center;
    text-align: center;
  }

  .page-banner-wide--has-image .page-banner-wide__heading,
  .page-banner-wide--has-image .page-banner-wide__subtext,
  .page-banner-wide--has-image .page-banner-wide__breadcrumb {
    color: rgb(var(--color-background, 255, 255, 255));
  }

  .page-banner-wide__breadcrumb {
    display: flex;
    gap: 6px;
    font-size: 1.2rem;
    opacity: 0.7;
  }

  .page-banner-wide__breadcrumb a {
    text-decoration: none;
    color: inherit;
  }

  .page-banner-wide__heading {
    font-size: var(--heading-size, 46px);
    font-weight: var(--heading-weight, 400);
    line-height: 1.1;
    margin: 0;
  }

  .page-banner-wide__subtext {
    font-size: var(--subtext-size, 18px);
    font-weight: var(--subtext-weight, 400);
    font-family: var(--font-body-family, 'DM Sans');
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .page-banner-wide__image--desktop {
      display: none;
    }

    .page-banner-wide__image--mobile {
      display: block;
    }

    .page-banner-wide__heading {
      font-size: var(--heading-size-mobile, 36px);
    }

    .page-banner-wide__subtext {
      font-size: var(--subtext-size-mobile, 14px);
    }

    .page-banner-wide__content {
      padding: 0px 20px;
      max-width: 400px;
    }

    .section.page-banner-wide {
      padding: 30px 0px;
    }

    div#shopify-section-template--30252635423047__page_banner_wide_fzQiD8 {
      width: 100%;
      padding: 60px 10px 0px 10px;
    }
  }
</style>

{% schema %}
{
  "name": "Page banner wide",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About Us"
    },
    {
      "type": "header",
      "content": "Heading typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Font size (desktop)",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 46
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Font size (mobile)",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "400"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "header",
      "content": "Subtext typography"
    },
    {
      "type": "range",
      "id": "subtext_size",
      "label": "Font size (desktop)",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "subtext_size_mobile",
      "label": "Font size (mobile)",
      "min": 10,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "subtext_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": false
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Background image (mobile)",
      "info": "Optional. Falls back to the desktop image if left blank."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay darkness",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Used when no background image is set",
      "placeholder": "Default"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 0,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Page banner wide"
    }
  ]
}
{% endschema %}
