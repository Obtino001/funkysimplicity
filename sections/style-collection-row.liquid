{%- comment -%}
  Shop by Style row
  - One card per block: collection + optional hand-picked image (like the live funkysimplicity.com style grid)
  - Desktop: all styles in one row (columns setting); extra styles scroll sideways
  - Mobile: swipeable row with scroll-snap; desktop supports mouse drag
  - Images are never cropped top/bottom so the full style shows
{%- endcomment -%}

{%- liquid
  assign section_id = section.id
  assign columns_desktop_setting = section.settings.columns_desktop | default: '4.5'
  assign col_num = columns_desktop_setting | plus: 0.0
  if col_num <= 0
    assign col_num = 4.5
  endif
  assign full_cards = col_num | floor
  if col_num == full_cards
    assign num_gaps = full_cards | minus: 1
  else
    assign num_gaps = full_cards
  endif
-%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section_id }}{% endif %}"
></div>

<section
  id="StyleCollectionRow-{{ section_id }}"
  class="section section--page-width style-collection-row"
  style="
    --scr-columns: {{ col_num }};
    --scr-gaps-count: {{ num_gaps }};
    --scr-gap: {{ section.settings.gap }}px;
    padding-block-start: {{ section.settings.padding_top }}px;
    padding-block-end: {{ section.settings.padding_bottom }}px;
    {% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}
  "
>
  <div class="scr-container">
    <div class="scr-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="scr-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="scr-header__arrows">
        <button
          type="button"
          class="scr-arrow-btn scr-arrow-prev"
          aria-label="Previous Slide"
          data-direction="prev"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          type="button"
          class="scr-arrow-btn scr-arrow-next"
          aria-label="Next Slide"
          data-direction="next"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <div class="scr-track-wrapper">
      <div class="scr-track" data-scr-track>
        {%- for block in section.blocks -%}
          {%- liquid
            assign collection = block.settings.collection
            assign card_image = block.settings.image | default: collection.featured_image
            assign card_title = block.settings.title | default: collection.title
            assign card_url = collection.url | default: routes.all_products_collection_url
          -%}
          <a href="{{ card_url }}" class="scr-card" draggable="false" {{ block.shopify_attributes }}>
            <div class="scr-card__media">
              {%- if card_image != blank -%}
                {{
                  card_image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    draggable: 'false',
                    sizes: '(min-width: 990px) calc(100vw / 4.5), 45vw',
                    widths: '300, 450, 600, 900',
                    alt: card_title
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'scr-card__placeholder' }}
              {%- endif -%}
            </div>
            {%- if card_title != blank -%}
              <span class="scr-card__title">{{ card_title | escape }}</span>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<style>
  .style-collection-row {
    position: relative;
    overflow: visible;
  }

  /* Capped to the site width (--fs-site-width) so every section lines up with the header. */
  .scr-container {
    width: 100%;
    max-width: var(--fs-site-width, 1600px);
    margin-inline: auto;
    box-sizing: border-box;
  }

  .scr-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 20px;
  }

  .scr-heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: normal;
  }

  .scr-header__arrows {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: auto;
  }

  .scr-header__arrows[hidden],
  .scr-arrow-btn[hidden] {
    display: none !important;
  }

  .scr-arrow-btn {
    appearance: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid #ebebeb;
    background: transparent;
    color: var(--color-foreground, #121212);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
  }

  .scr-arrow-btn:hover:not(:disabled) {
    border-color: #121212;
  }

  .scr-arrow-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* Track overflow wrapper: allows slides to bleed to right viewport edge on desktop */
  .scr-track-wrapper {
    position: relative;
    width: 100%;
    overflow: visible;
  }

  @media screen and (min-width: 990px) {
    .scr-track-wrapper {
      margin-right: calc(-1 * max(0px, (100vw - var(--fs-site-width, 1600px)) / 2));
      padding-right: max(0px, (100vw - var(--fs-site-width, 1600px)) / 2);
    }
  }

  .scr-track {
    display: flex;
    gap: var(--scr-gap);
    overflow: visible;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    cursor: grab;
    width: 100%;
    box-sizing: border-box;
    transition: transform 0.4s ease;
  }

  .scr-track::-webkit-scrollbar {
    display: none;
  }

  .scr-track.is-dragging {
    cursor: grabbing;
    transition: none;
  }

  .scr-track.is-dragging .scr-card {
    pointer-events: none;
  }

  .scr-card {
    flex: 0 0 calc((100% - (var(--scr-gap) * var(--scr-gaps-count, 4))) / var(--scr-columns, 4.5));
    width: calc((100% - (var(--scr-gap) * var(--scr-gaps-count, 4))) / var(--scr-columns, 4.5));
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    scroll-snap-align: start;
    box-sizing: border-box;
  }

  /* 2:3 box fits full-body shots; wider photos only lose a little at the sides, never head or feet. */
  .scr-card__media {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: #f6f6f6;
  }

  .scr-card__media img,
  .scr-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.5s ease;
    user-select: none;
    -webkit-user-drag: none;
  }

  .scr-card:hover .scr-card__media img {
    transform: scale(1.04);
  }

  .scr-card__title {
    font-family: var(--font-body--family);
    font-size: 15px;
    line-height: 1.3;
  }

  @media screen and (max-width: 989px) {
    .scr-card {
      flex: 0 0 clamp(180px, 32vw, 260px);
      width: clamp(180px, 32vw, 260px);
    }
  }

  @media screen and (max-width: 749px) {
    .scr-header__arrows {
      display: none;
    }

    .scr-heading {
      font-size: 1.5rem;
      margin-bottom: 12px;
    }

    .scr-card {
      flex: 0 0 clamp(150px, 42vw, 200px);
      width: clamp(150px, 42vw, 200px);
    }

    .scr-track {
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scroll-behavior: smooth;
    }

    .scr-card__title {
      font-size: 14px;
    }
  }
</style>

<script>
  (function () {
    const sectionEl = document.querySelector('#StyleCollectionRow-{{ section_id }}');
    if (!sectionEl) return;
    const track = sectionEl.querySelector('[data-scr-track]');
    if (!track || track.dataset.scrReady) return;
    track.dataset.scrReady = 'true';

    const prevBtn = sectionEl.querySelector('.scr-arrow-prev');
    const nextBtn = sectionEl.querySelector('.scr-arrow-next');
    let currentOffset = 0;

    function updateArrowStates() {
      if (!prevBtn || !nextBtn) return;
      const maxOffset = Math.max(0, track.scrollWidth - track.clientWidth);
      currentOffset = Math.max(0, Math.min(currentOffset, maxOffset));
      track.style.transform = `translateX(-${currentOffset}px)`;
      const canMovePrev = currentOffset > 2;
      const canMoveNext = currentOffset < maxOffset - 2;
      prevBtn.hidden = !canMovePrev;
      nextBtn.hidden = !canMoveNext;
      const arrows = sectionEl.querySelector('.scr-header__arrows');
      if (arrows) arrows.hidden = !canMovePrev && !canMoveNext;
      prevBtn.disabled = currentOffset <= 2;
      nextBtn.disabled = currentOffset >= maxOffset - 2;
    }

    function moveTrack(direction) {
      const maxOffset = Math.max(0, track.scrollWidth - track.clientWidth);
      currentOffset = Math.max(0, Math.min(currentOffset + direction * getStep(), maxOffset));
      track.style.transform = `translateX(-${currentOffset}px)`;
      updateArrowStates();
    }

    function getStep() {
      const firstCard = track.querySelector('.scr-card');
      const gap = parseFloat(getComputedStyle(track).gap) || 10;
      return (firstCard ? firstCard.getBoundingClientRect().width : 300) + gap;
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', (e) => {
        e.preventDefault();
        moveTrack(-1);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', (e) => {
        e.preventDefault();
        moveTrack(1);
      });
    }

    let startX = 0;
    let startScroll = 0;
    let moved = false;

    track.addEventListener('mousedown', (event) => {
      if (event.button !== 0 || track.scrollWidth <= track.clientWidth) return;
      startX = event.pageX;
      startScroll = currentOffset;
      moved = false;

      const onMove = (moveEvent) => {
        const delta = moveEvent.pageX - startX;
        if (!moved && Math.abs(delta) > 5) {
          moved = true;
          track.classList.add('is-dragging');
        }
        if (moved) {
          const maxOffset = Math.max(0, track.scrollWidth - track.clientWidth);
          currentOffset = Math.max(0, Math.min(startScroll - delta, maxOffset));
          track.style.transform = `translateX(-${currentOffset}px)`;
        }
      };

      const onUp = () => {
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onUp);
        track.classList.remove('is-dragging');
        updateArrowStates();
      };

      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onUp);
    });

    track.addEventListener('click', (event) => {
      if (moved) {
        event.preventDefault();
        moved = false;
      }
    }, true);

    updateArrowStates();
    window.addEventListener('resize', updateArrowStates);
  })();
</script>

{% schema %}
{
  "name": "Collection Row",
  "class": "section-style-collection-row",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Style"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Cards visible on desktop",
      "options": [
        { "value": "3", "label": "3 cards" },
        { "value": "3.5", "label": "3.5 cards" },
        { "value": "4", "label": "4 cards" },
        { "value": "4.5", "label": "4.5 cards" },
        { "value": "5", "label": "5 cards" },
        { "value": "5.5", "label": "5.5 cards" },
        { "value": "6", "label": "6 cards" },
        { "value": "7", "label": "7 cards" },
        { "value": "8", "label": "8 cards" },
        { "value": "9", "label": "9 cards" }
      ],
      "default": "4.5"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between cards",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "style",
      "name": "Style",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image",
          "info": "Optional. Leave empty to use the collection image."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card title",
          "info": "Optional. Leave empty to use the collection name."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Row"
    }
  ]
}
{% endschema %}
