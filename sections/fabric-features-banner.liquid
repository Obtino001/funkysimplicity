    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "page", "label": "Page Width" },
        { "value": "full", "label": "Full Width" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop Feature Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "section_min_height",
      "label": "Section Minimum Height",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "500px", "label": "500px" },
        { "value": "650px", "label": "650px" },
        { "value": "80vh", "label": "80% Viewport" },
        { "value": "100vh", "label": "Full Viewport" }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature / Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Preset Icon",
          "options": [
            { "value": "cotton", "label": "Cotton Flower" },
            { "value": "flask", "label": "No Microplastics (Flask)" },
            { "value": "clock_recycle", "label": "Lasts For Years (Clock & Recycle)" },
