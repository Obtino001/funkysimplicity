

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section image-text{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --padding-block-start: {{ section.settings.padding_block_start }}px;
    --padding-block-end: {{ section.settings.padding_block_end }}px;
    --heading-size: {{ section.settings.heading_size }}px;
    --heading-weight: {{ section.settings.heading_weight }};
    --body-size: {{ section.settings.body_size }}px;
    --body-weight: {{ section.settings.body_weight }};
    --signature-size: {{ section.settings.signature_size }}px;
    --signature-weight: {{ section.settings.signature_weight }};
  "
>
  <div class="image-text__grid image-text__grid--image-{{ section.settings.image_position }}">
    <div class="image-text__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag: loading: 'lazy', class: 'image-text__img', sizes: '(min-width: 990px) 45vw, 100vw'
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'image-text__img' }}
      {%- endif -%}
    </div>

    <div class="image-text__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="image-text__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.content != blank -%}
        <div class="image-text__body rte">{{ section.settings.content }}</div>
      {%- endif -%}

      {%- if section.settings.signature != blank -%}
        <div class="image-text__signature rte">{{ section.settings.signature }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
        <a href="{{ section.settings.button_url }}" class="button image-text__button">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .image-text {
    padding-block-start: var(--padding-block-start, 64px);
    padding-block-end: var(--padding-block-end, 64px);
    padding-inline: var(--page-margin, 24px);
  }

  .image-text__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    max-width: var(--page-width, 1400px);
    margin-inline: auto;
    align-items: center;
    width:1019px;
  }

  .image-text__media {
    order: 1;
  }

  .image-text__content {
    order: 2;
  }

  .image-text__img {
    width: 392px;
    height: 558px;
    display: block;
    border-radius: 0px;
    object-fit: cover;
  }

  .image-text__heading {
    font-size: var(--heading-size, 26px);
    font-weight: var(--heading-weight, 600);
    margin: 0 0 16px;
  }

  .image-text__body {
    font-size: var(--body-size, 14px);
    font-weight: var(--body-weight, 400);
  }

  .image-text__body p + p {
    margin-top: 16px;
  }

  .image-text__signature {
    margin-top: 20px;
    font-size: var(--signature-size, 14px);
    font-weight: var(--signature-weight, 400);
    line-height: 1.5;
  }

  .image-text__button {
    display: inline-block;
    margin-top: 24px;
  }
  .image-text__media {
    align-items: center;
    margin: auto;
}
section#IconFeaturesBar-template--30227266765127__icon_features_bar_3NBTjj {
    max-width: 1440px;
    margin: auto;
    margin-Bottom:50px;
}


  @media screen and (min-width: 990px) {
    .image-text__grid {
      grid-template-columns: 1fr 1fr;
      gap: 60px;
    }

    .image-text__grid--image-right .image-text__media {
      order: 2;
    }

    .image-text__grid--image-right .image-text__content {
      order: 1;
    }

    .image-text__grid--image-left .image-text__media {
      order: 1;
    }

    .image-text__grid--image-left .image-text__content {
      order: 2;
    }
  }

  @media (max-width: 768px){
  div #shopify-section-template--30227266765127__image_with_text_hUwdeB {
    display: none;
}
}
</style>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet the founder"
    },
    {
      "type": "header",
      "content": "Heading typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Font size",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 26
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "600"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "header",
      "content": "Content typography"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Font size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "body_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "400"
    },
    {
      "type": "richtext",
      "id": "signature",
      "label": "Signature line",
      "info": "e.g. \"With love and gratitude, Sanne\""
    },
    {
      "type": "header",
      "content": "Signature typography"
    },
    {
      "type": "range",
      "id": "signature_size",
      "label": "Font size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "signature_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "400"
    },
    {
      "type": "header",
      "content": "Optional button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "placeholder": "Default"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 65
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 65
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
