{%- doc -%}
  Crisp line icons for the brand trust badges (PDP benefits + icon features bar).
  Inherits color from the surrounding text via currentColor.

  @param {string} icon - quality | handmade | stretch | artwork
  @param {string} [class] - Extra class for the svg element
{%- enddoc -%}

<svg
  class="feature-icon {{ class }}"
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'quality' -%}
      <ellipse cx="10" cy="13" rx="4" ry="7"/>
      <ellipse cx="10" cy="13" rx="1.2" ry="2.2"/>
      <path d="M10 6h16a4 7 0 0 1 0 14H10"/>
      <path d="M14 20v13l3-1.5 3 1.5 3-1.5 3 1.5V20"/>
      <path d="M33 4.5l1.2 2.5 2.7.4-2 1.9.5 2.7-2.4-1.3-2.4 1.3.5-2.7-2-1.9 2.7-.4z"/>
    {%- when 'handmade' -%}
      <path d="M20 18.5c-3.2-2.6-6-4.6-6-7.4a3.2 3.2 0 0 1 6-1.5 3.2 3.2 0 0 1 6 1.5c0 2.8-2.8 4.8-6 7.4z"/>
      <path d="M5 23v13"/>
      <path d="M5 25h6l7 2.5h5a2 2 0 0 1 0 4h-6"/>
      <path d="M23 31l7.2-3.6a2 2 0 0 1 2.2 3.3L24 36H13l-8-2"/>
    {%- when 'stretch' -%}
      <rect x="15" y="15" width="10" height="10" rx="2"/>
      <path d="M20 4v8M16.5 7.5 20 4l3.5 3.5"/>
      <path d="M20 28v8M16.5 32.5 20 36l3.5-3.5"/>
      <path d="M4 20h8M7.5 16.5 4 20l3.5 3.5"/>
      <path d="M28 20h8M32.5 16.5 36 20l-3.5 3.5"/>
    {%- when 'artwork' -%}
      <path d="M20 5C11.7 5 5 11.3 5 19c0 6.5 5 10 9 10 2.5 0 3-1.7 3-3 0-1.6 1.2-3 3-3h4c6 0 11-3.4 11-8.5C35 9.6 28.3 5 20 5z"/>
      <circle cx="12" cy="17.5" r="1.6"/>
      <circle cx="16" cy="11.5" r="1.6"/>
      <circle cx="23" cy="10.5" r="1.6"/>
      <circle cx="28.5" cy="15" r="1.6"/>
      <path d="M27 26l6 7"/>
      <path d="M25.5 24.5c-1.6.4-2.4 1.8-2 3.3l.4 1.2 1.2-.2c1.5-.3 2.5-1.6 2.3-3.2z"/>
  {%- endcase -%}
</svg>
