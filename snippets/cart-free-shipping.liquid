{% doc %}
  Renders the free shipping progress bar shown at the top of the cart drawer.

  Reads `settings.cart_free_shipping_*` from the theme settings.

  @example
  {% render 'cart-free-shipping' %}
{% enddoc %}

{%- if settings.cart_free_shipping_bar -%}
  {%- liquid
    assign threshold = settings.cart_free_shipping_threshold | plus: 0 | times: 100 | round
    assign current = cart.total_price

    if threshold > 0
      assign remaining = threshold | minus: current
      if remaining < 0
        assign remaining = 0
      endif
      assign progress = current | times: 100.0 | divided_by: threshold
      if progress > 100
        assign progress = 100
      endif
    else
      assign remaining = 0
      assign progress = 100
    endif

    assign remaining_money = remaining | money

    if remaining > 0
      assign fs_message = settings.cart_free_shipping_progress_text | replace: '[amount]', remaining_money
    else
      assign fs_message = settings.cart_free_shipping_success_text
    endif

    # A legacy setting saved as just "[amount]" renders only a price (for
    # example €0.00) in the drawer. Keep the progress copy complete.
    if fs_message == blank or fs_message == remaining_money
      if remaining > 0
        assign fs_message = 'Spend [amount] more and get free shipping' | replace: '[amount]', remaining_money
      else
        assign fs_message = "Congratulations you've received free shipping on your order"
      endif
    endif
  -%}

  <div class="cart-free-shipping{% if remaining == 0 %} cart-free-shipping--reached{% endif %}">
    <div
      class="cart-free-shipping__track"
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ progress | round }}"
      aria-label="{{ fs_message | escape }}"
    >
      <span
        class="cart-free-shipping__fill"
        style="--cart-free-shipping-progress: {{ progress }}%;"
      >
        <span class="cart-free-shipping__knob"></span>
      </span>
    </div>

    <p class="cart-free-shipping__message">
      <span>{{ fs_message }}</span>
      <span class="cart-free-shipping__icon" aria-hidden="true">
        {%- render 'icon-gift' -%}
      </span>
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .cart-free-shipping {
    padding-inline: var(--cart-drawer-padding);
    padding-block-end: var(--padding-md);
    flex-shrink: 0;
    margin-top: 0;
  }

  .cart-free-shipping__track {
    position: relative;
    height: 8px;
    border-radius: 99px;
    background-color: rgb(var(--color-foreground-rgb) / 0.12);
    margin-block: 11px 10px;
  }

  .cart-free-shipping__fill {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    display: block;
    width: var(--cart-free-shipping-progress, 0%);
    min-width: 4px;
    border-radius: 99px;
    background-color: var(--color-foreground);
    transition: width var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .cart-free-shipping__knob {
    position: absolute;
    inset-inline-end: 0;
    top: 50%;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background-color: var(--color-foreground);
    transform: translate(50%, -50%);
  }

  .cart-free-shipping__message {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: 0;
    padding: 5px 8px;
    border-radius: 0;
    background-color: #f6f6f6;
    font-size: 12px;
    text-align: center;
    line-height: 1.4;
  }

  .cart-free-shipping__icon svg {
    display: block;
    width: 18px;
    height: 18px;
  }
{% endstylesheet %}
