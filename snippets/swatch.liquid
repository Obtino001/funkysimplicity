{%- doc -%}
  Renders a swatch either from a variant image object or a swatch object.

  @param {object} [swatch] - a swatch object
  @param {object} [variant_image] - an alternate image when there is no swatch value
  @param {string} [mode] - one of 'unscaled', 'filter', 'pill'
  @param {string} [label] - visually-hidden accessible label for the swatch (e.g. the color name)
  @param {string} [color_name] - name of the color or option value (e.g. 'Cream Black')
  @param {string} [value] - fallback option value string

  @example
  {% render 'swatch', swatch: swatch, variant_image: variant_image, mode: 'unscaled', label: option_value.name, color_name: option_value.name %}
{%- enddoc -%}

{% liquid
  assign swatch_value = null
  assign extra_classes = ''
  assign raw_color_name = color_name | default: value | default: label | default: ''

  if settings.show_variant_image and variant_image
    assign swatch_image_width = settings.variant_swatch_width | default: 28 | times: 2
    assign swatch_image_url = variant_image | image_url: width: swatch_image_width
    assign swatch_value = 'url(' | append: swatch_image_url | append: ')'
    assign extra_classes = extra_classes | append: ' swatch--variant-image'
  elsif swatch.image
    assign swatch_image_url = swatch.image | image_url: width: 80
    assign swatch_value = 'url(' | append: swatch_image_url | append: ')'
  elsif swatch.color
    assign swatch_value = 'rgb(' | append: swatch.color.rgb | append: ')'
  endif

  if swatch_value == null and raw_color_name != blank
    assign downcased_name = raw_color_name | downcase | strip

    # Check for multi-tone / two-color combinations (e.g., 'Cream Black', 'Cream / Black', 'Black/White')
    assign normalized_name = downcased_name | replace: ' / ', '/' | replace: ' - ', '/' | replace: ' & ', '/' | replace: ' and ', '/'
    if normalized_name contains '/'
      assign parts = normalized_name | split: '/'
    elsif normalized_name contains ' '
      assign parts = normalized_name | split: ' '
    else
      assign parts = nil
    endif

    if parts != nil and parts.size >= 2
      assign color_1_name = parts[0] | strip
      assign color_2_name = parts[1] | strip

      assign color_1_hex = color_1_name
      case color_1_name
        when 'cream'
          assign color_1_hex = '#FFFDD0'
        when 'black'
          assign color_1_hex = '#000000'
        when 'white'
          assign color_1_hex = '#FFFFFF'
        when 'off-white', 'off white'
          assign color_1_hex = '#FAF9F6'
        when 'ivory'
          assign color_1_hex = '#FFFFF0'
        when 'nude'
          assign color_1_hex = '#E3BC9A'
        when 'beige'
          assign color_1_hex = '#F5F5DC'
        when 'khaki'
          assign color_1_hex = '#C3B091'
        when 'sage'
          assign color_1_hex = '#9CAF88'
        when 'olive'
          assign color_1_hex = '#708238'
        when 'navy'
          assign color_1_hex = '#000080'
        when 'charcoal'
          assign color_1_hex = '#36454F'
        when 'taupe'
          assign color_1_hex = '#483C32'
        when 'grey', 'gray'
          assign color_1_hex = '#808080'
        when 'gold'
          assign color_1_hex = '#FFD700'
        when 'silver'
          assign color_1_hex = '#C0C0C0'
        when 'pink'
          assign color_1_hex = '#FFC0CB'
        when 'terracotta'
          assign color_1_hex = '#E2725B'
        when 'burgundy'
          assign color_1_hex = '#800020'
        when 'wine'
          assign color_1_hex = '#722F37'
        when 'camel'
          assign color_1_hex = '#C19A6B'
        when 'tan'
          assign color_1_hex = '#D2B48C'
        when 'brown'
          assign color_1_hex = '#964B00'
        when 'lilac'
          assign color_1_hex = '#C8A2C8'
        when 'lavender'
          assign color_1_hex = '#E6E6FA'
        when 'mint'
          assign color_1_hex = '#98FF98'
        when 'teal'
          assign color_1_hex = '#008080'
        when 'emerald'
          assign color_1_hex = '#50C878'
      endcase

      assign color_2_hex = color_2_name
      case color_2_name
        when 'cream'
          assign color_2_hex = '#FFFDD0'
        when 'black'
          assign color_2_hex = '#000000'
        when 'white'
          assign color_2_hex = '#FFFFFF'
        when 'off-white', 'off white'
          assign color_2_hex = '#FAF9F6'
        when 'ivory'
          assign color_2_hex = '#FFFFF0'
        when 'nude'
          assign color_2_hex = '#E3BC9A'
        when 'beige'
          assign color_2_hex = '#F5F5DC'
        when 'khaki'
          assign color_2_hex = '#C3B091'
        when 'sage'
          assign color_2_hex = '#9CAF88'
        when 'olive'
          assign color_2_hex = '#708238'
        when 'navy'
          assign color_2_hex = '#000080'
        when 'charcoal'
          assign color_2_hex = '#36454F'
        when 'taupe'
          assign color_2_hex = '#483C32'
        when 'grey', 'gray'
          assign color_2_hex = '#808080'
        when 'gold'
          assign color_2_hex = '#FFD700'
        when 'silver'
          assign color_2_hex = '#C0C0C0'
        when 'pink'
          assign color_2_hex = '#FFC0CB'
        when 'terracotta'
          assign color_2_hex = '#E2725B'
        when 'burgundy'
          assign color_2_hex = '#800020'
        when 'wine'
          assign color_2_hex = '#722F37'
        when 'camel'
          assign color_2_hex = '#C19A6B'
        when 'tan'
          assign color_2_hex = '#D2B48C'
        when 'brown'
          assign color_2_hex = '#964B00'
        when 'lilac'
          assign color_2_hex = '#C8A2C8'
        when 'lavender'
          assign color_2_hex = '#E6E6FA'
        when 'mint'
          assign color_2_hex = '#98FF98'
        when 'teal'
          assign color_2_hex = '#008080'
        when 'emerald'
          assign color_2_hex = '#50C878'
      endcase

      assign swatch_value = 'linear-gradient(135deg, ' | append: color_1_hex | append: ' 50%, ' | append: color_2_hex | append: ' 50%)'
    else
      case downcased_name
        when 'cream'
          assign swatch_value = '#FFFDD0'
        when 'black'
          assign swatch_value = '#000000'
        when 'white'
          assign swatch_value = '#FFFFFF'
        when 'off-white', 'off white'
          assign swatch_value = '#FAF9F6'
        when 'ivory'
          assign swatch_value = '#FFFFF0'
        when 'nude'
          assign swatch_value = '#E3BC9A'
        when 'beige'
          assign swatch_value = '#F5F5DC'
        when 'khaki'
          assign swatch_value = '#C3B091'
        when 'sage'
          assign swatch_value = '#9CAF88'
        when 'olive'
          assign swatch_value = '#708238'
        when 'navy', 'navy blue'
          assign swatch_value = '#000080'
        when 'charcoal'
          assign swatch_value = '#36454F'
        when 'taupe'
          assign swatch_value = '#483C32'
        when 'grey', 'gray'
          assign swatch_value = '#808080'
        when 'light grey', 'light gray'
          assign swatch_value = '#D3D3D3'
        when 'dark grey', 'dark gray'
          assign swatch_value = '#A9A9A9'
        when 'gold'
          assign swatch_value = '#FFD700'
        when 'silver'
          assign swatch_value = '#C0C0C0'
        when 'pink'
          assign swatch_value = '#FFC0CB'
        when 'hot pink'
          assign swatch_value = '#FF69B4'
        when 'rose'
          assign swatch_value = '#FF007F'
        when 'blush'
          assign swatch_value = '#DE5D83'
        when 'coral'
          assign swatch_value = '#FF7F50'
        when 'terracotta'
          assign swatch_value = '#E2725B'
        when 'rust'
          assign swatch_value = '#B7410E'
        when 'burgundy'
          assign swatch_value = '#800020'
        when 'wine'
          assign swatch_value = '#722F37'
        when 'maroon'
          assign swatch_value = '#800000'
        when 'red'
          assign swatch_value = '#FF0000'
        when 'blue'
          assign swatch_value = '#0000FF'
        when 'sky blue'
          assign swatch_value = '#87CEEB'
        when 'royal blue'
          assign swatch_value = '#4169E1'
        when 'camel'
          assign swatch_value = '#C19A6B'
        when 'tan'
          assign swatch_value = '#D2B48C'
        when 'brown'
          assign swatch_value = '#964B00'
        when 'chocolate'
          assign swatch_value = '#7B3F00'
        when 'lilac'
          assign swatch_value = '#C8A2C8'
        when 'lavender'
          assign swatch_value = '#E6E6FA'
        when 'plum'
          assign swatch_value = '#8E4585'
        when 'purple'
          assign swatch_value = '#800080'
        when 'mint'
          assign swatch_value = '#98FF98'
        when 'teal'
          assign swatch_value = '#008080'
        when 'turquoise'
          assign swatch_value = '#40E0D0'
        when 'aqua'
          assign swatch_value = '#00FFFF'
        when 'emerald'
          assign swatch_value = '#50C878'
        when 'copper'
          assign swatch_value = '#B87333'
        when 'bronze'
          assign swatch_value = '#CD7F32'
        when 'sand'
          assign swatch_value = '#C2B280'
        when 'yellow'
          assign swatch_value = '#FFFF00'
        when 'mustard'
          assign swatch_value = '#E1AD01'
        when 'green'
          assign swatch_value = '#008000'
        else
          if variant_image
            assign swatch_image_url = variant_image | image_url: width: 80
            assign swatch_value = 'url(' | append: swatch_image_url | append: ')'
          else
            assign swatch_value = downcased_name
          endif
      endcase
    endif
  endif

  case mode
    when 'unscaled'
      assign extra_classes = extra_classes | append: ' swatch--unscaled'
    when 'filter'
      assign extra_classes = extra_classes | append: ' swatch--filter'
    when 'pill'
      assign extra_classes = extra_classes | append: ' swatch--pill'
  endcase
%}

<span
  class="
    swatch
    {{ extra_classes }}
    {% if swatch_value == null %} swatch--unavailable{% endif %}
  "
  style="
    --swatch-background: {{ swatch_value }};
    {% if swatch.image and settings.show_variant_image == false %} --swatch-focal-point: {{ swatch.image.presentation.focal_point }};{% endif %}
  "
>
</span>
{%- if label != blank -%}
  <span class="visually-hidden">{{ label }}</span>
{%- endif -%}
