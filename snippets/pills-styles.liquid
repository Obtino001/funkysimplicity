{%- doc -%}
  Shared pill styles used by active filters and predictive-search query suggestions.

  @example
  {% render 'pills-styles' %}
{%- enddoc -%}

{% stylesheet %}
  /* Pills (used in facets and predictive search) */

  .pills__pill {
    --pills-pill-background-color: var(--color-brand-green-tint, #eef1ea);

    color: #171717;
    display: inline-flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    min-width: 48px;
    padding: 6px 12px;
    border: 1px solid rgba(89, 111, 83, 0.25);
    border-radius: var(--style-border-radius-pills, 4px);
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
    cursor: pointer;
    background-color: var(--pills-pill-background-color);
    transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;

    &:hover {
      --pills-pill-background-color: var(--color-brand-green, #596f53);
      border-color: var(--color-brand-green, #596f53);
      color: #ffffff;
    }

    @media screen and (max-width: 749px) {
      padding: 6px 10px;
    }
  }

  .pills__pill > .svg-wrapper {
    --close-icon-opacity: 0.75;
    --icon-stroke-width: 1.5px;

    color: currentColor;
  }

  .pills__pill--swatch {
    @media screen and (max-width: 749px) {
      padding-inline-start: var(--padding-sm);
    }
  }

  .pills__pill--swatch .swatch {
    margin-right: -4px;
  }

  .pills__pill--desktop-small {
    @media screen and (min-width: 750px) {
      font-size: var(--font-size--xs);
    }
  }
{% endstylesheet %}
