{%- doc -%}
  Product-card JS (variant pills, swatches, add to cart).

  Card CSS lives in assets/product-card.css and is loaded from the layout head
  as a blocking stylesheet. Horizon {% stylesheet %} is async and flashes
  unstyled cards on collection pages.

  @example
    {% render 'product-card-styles' %}
{%- enddoc -%}

{% javascript %}
  (function() {
    function formatMoney(cents) {
      let formatted = '$' + (cents / 100).toFixed(2);
      if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
        formatted = window.Shopify.formatMoney(cents);
      }
      const textarea = document.createElement('textarea');
      textarea.innerHTML = formatted;
      return textarea.value;
    }

    function initThemeProductCard(card) {
      if (!card || card.dataset.tccCardInitialized) return;
      card.dataset.tccCardInitialized = 'true';

      const dataScript = card.querySelector('.tcc-product-json');
      if (!dataScript) return;

      let productData;
      try {
        productData = JSON.parse(dataScript.textContent);
      } catch(e) {
        return;
      }

      const optPills = card.querySelectorAll('.tcc-opt-pill');
      const addBtn = card.querySelector('.tcc-add-btn:not(.mobile)');
      const mobileBtn = card.querySelector('.tcc-add-btn.mobile');
      const priceRegular = card.querySelector('.tcc-price--regular');
      const priceSale = card.querySelector('.tcc-price--sale');
      const priceCompare = card.querySelector('.tcc-price--compare');
      const saveBadge = card.querySelector('.tcc-save-badge');
      const primaryImg = card.querySelector('.tcc-card__img--primary') || card.querySelector('.tcc-card__img');
      const swatches = card.querySelectorAll('.tcc-swatch-item');
      const swatchesContainer = card.querySelector('.tcc-swatches');

      const selectedOptions = {};

      let colorOptionPosition = null;
      if (swatchesContainer && swatchesContainer.dataset.colorOptionIndex) {
        colorOptionPosition = swatchesContainer.dataset.colorOptionIndex;
      } else if (productData && productData.options) {
        productData.options.forEach((opt, idx) => {
          const name = (typeof opt === 'string' ? opt : opt.name || '').toLowerCase();
          if (name.includes('color') || name.includes('colour')) {
            colorOptionPosition = (idx + 1).toString();
          }
        });
      }

      if (colorOptionPosition) {
        const activeSwatch = card.querySelector('.tcc-swatch-item.is-selected') || swatches[0];
        if (activeSwatch) {
          selectedOptions[colorOptionPosition] = activeSwatch.dataset.colorValue;
        }
      }

      card.querySelectorAll('.tcc-option-group').forEach(group => {
        const optIndex = group.dataset.optionIndex;
        const activePill = group.querySelector('.tcc-opt-pill.is-selected') || group.querySelector('.tcc-opt-pill');
        if (activePill) {
          selectedOptions[optIndex] = activePill.dataset.value;
        }
      });

      function resolveVariant() {
        if (!productData || !productData.variants) return null;
        let found = productData.variants.find(v => {
          return Object.keys(selectedOptions).every(idx => {
            const optKey = 'option' + idx;
            return v[optKey] === selectedOptions[idx];
          });
        });
        if (!found && colorOptionPosition) {
          found = productData.variants.find(v => {
            return v['option' + colorOptionPosition] === selectedOptions[colorOptionPosition];
          });
        }
        return found || productData.variants[0];
      }

      function updateCardState() {
        const variant = resolveVariant();

        if (variant) {
          const formattedPrice = formatMoney(variant.price);
          if (variant.compare_at_price > variant.price) {
            if (priceSale) priceSale.textContent = formattedPrice;
            if (priceCompare) priceCompare.textContent = formatMoney(variant.compare_at_price);
            if (saveBadge) {
              const diff = variant.compare_at_price - variant.price;
              saveBadge.textContent = 'Save ' + formatMoney(diff);
              saveBadge.style.display = 'inline-block';
            }
            if (priceRegular) priceRegular.style.display = 'none';
            if (priceSale) priceSale.style.display = 'inline';
            if (priceCompare) priceCompare.style.display = 'inline';
          } else {
            if (priceRegular) {
              priceRegular.textContent = formattedPrice;
              priceRegular.style.display = 'inline';
            }
            if (priceSale) priceSale.style.display = 'none';
            if (priceCompare) priceCompare.style.display = 'none';
            if (saveBadge) saveBadge.style.display = 'none';
          }

          if (addBtn) {
            addBtn.dataset.variantId = variant.id;
            if (variant.available) {
              addBtn.disabled = false;
              addBtn.textContent = 'ADD TO CART';
            } else {
              addBtn.disabled = true;
              addBtn.textContent = 'SOLD OUT';
            }
          }
        } else {
          if (addBtn) {
            addBtn.disabled = true;
            addBtn.textContent = 'UNAVAILABLE';
          }
        }
      }

      optPills.forEach(pill => {
        pill.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const group = pill.closest('.tcc-option-group');
          if (!group) return;
          const optIndex = group.dataset.optionIndex;
          const value = pill.dataset.value;

          group.querySelectorAll('.tcc-opt-pill').forEach(p => p.classList.remove('is-selected'));
          pill.classList.add('is-selected');

          selectedOptions[optIndex] = value;
          updateCardState();
        });
      });

      swatches.forEach(swatch => {
        const selectSwatch = (e) => {
          if (e.type === 'click') {
            e.preventDefault();
            e.stopPropagation();
          }
          const colorVal = swatch.dataset.colorValue;
          let imgUrl = swatch.dataset.variantImage;

          swatches.forEach(s => s.classList.remove('is-selected'));
          swatch.classList.add('is-selected');
          card.classList.add('has-color-selected');

          if (colorOptionPosition) {
            selectedOptions[colorOptionPosition] = colorVal;
          }

          if (!imgUrl && productData && productData.variants) {
            const vMatch = productData.variants.find(v => {
              return (v.option1 === colorVal || v.option2 === colorVal || v.option3 === colorVal || (v.title && v.title.includes(colorVal))) && v.featured_image && v.featured_image.src;
            });
            if (vMatch && vMatch.featured_image) {
              imgUrl = vMatch.featured_image.src;
            }
          }

          if (imgUrl && primaryImg) {
            primaryImg.src = imgUrl;
            primaryImg.removeAttribute('srcset');
            primaryImg.style.opacity = '1';
            primaryImg.style.display = 'block';
            const secImg = card.querySelector('.tcc-card__img--secondary');
            if (secImg) {
              secImg.style.opacity = '0';
              secImg.style.display = 'none';
            }
          }

          updateCardState();
        };

        swatch.addEventListener('click', selectSwatch);
        swatch.addEventListener('mouseenter', selectSwatch);
      });

      if (mobileBtn) {
        mobileBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          if (!card.querySelector('.tcc-option-group')) {
            if (addBtn) addBtn.click();
            return;
          }
          document.querySelectorAll('.tcc-card.is-quick-shop-open').forEach((openCard) => {
            if (openCard !== card) openCard.classList.remove('is-quick-shop-open');
          });
          card.classList.toggle('is-quick-shop-open');
        });
      }

      if (addBtn) {
        addBtn.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();

          const variantId = addBtn.dataset.variantId;
          if (!variantId || addBtn.disabled) return;

          addBtn.classList.add('is-loading');
          addBtn.disabled = true;

          try {
            const formData = new FormData();
            formData.append('id', variantId);
            formData.append('quantity', '1');
            formData.append('sections', 'cart-drawer-section,cart-drawer,main-cart-items,cart-icon-bubble');
            formData.append('sections_url', window.location.pathname);

            const response = await fetch('/cart/add.js', {
              method: 'POST',
              body: formData
            });

            if (response.ok) {
              const resData = await response.json();

              if (resData.sections) {
                Object.keys(resData.sections).forEach(secKey => {
                  const html = resData.sections[secKey];
                  const targets = document.querySelectorAll(`[data-section-id="${secKey}"], #${secKey}, #shopify-section-${secKey}`);
                  targets.forEach(target => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const newEl = doc.querySelector(`[data-section-id="${secKey}"], #${secKey}, #shopify-section-${secKey}`) || doc.body.firstElementChild;
                    if (newEl) {
                      target.innerHTML = newEl.innerHTML;
                    }
                  });
                });
              }

              try {
                const freshRes = await fetch(`${window.Shopify?.routes?.root || '/'}?section_id=cart-drawer-section`);
                if (freshRes.ok) {
                  const freshHtml = await freshRes.text();
                  const parser = new DOMParser();
                  const doc = parser.parseFromString(freshHtml, 'text/html');
                  const drawerDialog = document.querySelector('theme-drawer#cart-drawer dialog') || document.querySelector('theme-drawer[id*="cart"] dialog') || document.querySelector('#cart-drawer');
                  const newDialog = doc.querySelector('dialog') || doc.querySelector('#cart-drawer');
                  if (drawerDialog && newDialog) {
                    drawerDialog.innerHTML = newDialog.innerHTML;
                  }
                }
              } catch(fetchErr) {
                console.log('Drawer refresh:', fetchErr);
              }

              document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail: { item: resData } }));
              document.dispatchEvent(new CustomEvent('shopify:cart:lines-update', { bubbles: true, detail: { item: resData } }));

              const themeDrawer = document.querySelector('theme-drawer#cart-drawer') || document.querySelector('theme-drawer[id*="cart"]');
              if (themeDrawer && typeof themeDrawer.open === 'function') {
                themeDrawer.open();
              }

              card.classList.remove('is-quick-shop-open');
            } else {
              console.error('Error adding to cart');
            }
          } catch(err) {
            console.error('Add to cart exception:', err);
          } finally {
            addBtn.classList.remove('is-loading');
            addBtn.disabled = false;
            updateCardState();
          }
        });
      }

      updateCardState();
    }

    function initAllProductCards() {
      document.querySelectorAll('.tcc-card').forEach(initThemeProductCard);
    }

    document.addEventListener('DOMContentLoaded', initAllProductCards);
    document.addEventListener('shopify:section:load', initAllProductCards);

    document.addEventListener('click', (e) => {
      if (e.target.closest('.tcc-card')) return;
      document.querySelectorAll('.tcc-card.is-quick-shop-open').forEach((openCard) => {
        openCard.classList.remove('is-quick-shop-open');
      });
    });

    // Dynamic Observer for infinite scroll & AJAX filter product grid updates
    if (typeof MutationObserver !== 'undefined') {
      const observer = new MutationObserver((mutations) => {
        let hasNew = false;
        mutations.forEach(m => {
          if (m.addedNodes && m.addedNodes.length > 0) hasNew = true;
        });
        if (hasNew) initAllProductCards();
      });
      const observeBody = () => {
        if (document.body) observer.observe(document.body, { childList: true, subtree: true });
      };
      if (document.body) {
        observeBody();
      } else {
        document.addEventListener('DOMContentLoaded', observeBody, { once: true });
      }
    }

    if (document.readyState === 'interactive' || document.readyState === 'complete') {
      initAllProductCards();
    }
  })();
{% endjavascript %}
