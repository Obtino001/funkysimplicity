{%- comment -%}
  Renders a single customer review card from block settings.
  @param {object} block - The review block object
{%- endcomment -%}

{%- liquid
  assign author = block.settings.author | default: 'Customer'
  assign avatar_img = block.settings.avatar_image
  assign avatar_color = block.settings.avatar_color | default: '#e06d53'
  assign rating = block.settings.rating | default: 5
  assign review_text = block.settings.text
  assign date_text = block.settings.date | default: '4 months ago'
  assign show_badge = block.settings.show_google_badge

  # Initials from author name
  assign initial_char = author | slice: 0, 1 | upcase
-%}

<div class="gr-card" {{ block.shopify_attributes }}>
  <div class="gr-card__header">
    <div class="gr-card__avatar" style="background-color: {{ avatar_color }};">
      {%- if avatar_img != blank -%}
        <img
          src="{{ avatar_img | image_url: width: 90 }}"
          alt="{{ author | escape }}"
          width="42"
          height="42"
          loading="lazy"
        >
      {%- else -%}
        <span>{{ initial_char }}</span>
      {%- endif -%}

      {%- if show_badge -%}
        <span class="gr-card__google-badge" title="Google Verified Review">
          <svg viewBox="0 0 24 24" width="10" height="10">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
        </span>
      {%- endif -%}
    </div>

    <div class="gr-card__meta">
      <h3 class="gr-card__author">{{ author }}</h3>
      <div class="gr-card__stars" aria-label="{{ rating }} out of 5 stars">
        {%- for i in (1..5) -%}
          <svg class="gr-star" viewBox="0 0 20 20" fill="currentColor">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if review_text != blank -%}
    <p class="gr-card__text">{{ review_text }}</p>
  {%- endif -%}

  {%- if date_text != blank -%}
    <div class="gr-card__date">{{ date_text }}</div>
  {%- endif -%}
</div>
