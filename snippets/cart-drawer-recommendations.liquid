{% doc %}
  Renders the "Compare your style" recommendations block inside the cart drawer.

  The list itself is fetched from the product recommendations route by
  `assets/cart-drawer-recommendations.js` and rendered by
  `sections/cart-drawer-recommendations.liquid`.

  @example
  {% render 'cart-drawer-recommendations' %}
{% enddoc %}

{%- if settings.cart_drawer_recommendations and cart.item_count > 0 -%}
  {%- assign seed_product = cart.items.first.product -%}

  <script
    type="module"
    src="{{ 'cart-drawer-recommendations.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  <cart-drawer-recommendations
    class="cart-recommendations"
    data-url="{{ routes.product_recommendations_url }}"
    data-product-id="{{ seed_product.id }}"
    data-limit="{{ settings.cart_drawer_recommendations_limit | default: 4 }}"
    data-section-id="cart-drawer-recommendations"
    data-cart-add-url="{{ routes.cart_add_url }}"
    hidden
  >
    <div class="cart-recommendations__heading">
      <span>{{ settings.cart_drawer_recommendations_title | default: 'Compare Your Style' }}</span>
    </div>

    <div data-recommendations-target></div>
  </cart-drawer-recommendations>
{%- endif -%}

{% stylesheet %}
  cart-drawer-recommendations {
    display: block;
    padding-inline: var(--cart-drawer-padding);
    padding-block: var(--padding-lg) var(--padding-md);
  }

  cart-drawer-recommendations[hidden] {
    display: none;
  }

  .cart-recommendations__heading {
    display: flex;
    align-items: center;
    gap: var(--gap-md);
    margin-block-end: var(--margin-lg);
    font-family: var(--font-heading--family);
    font-size: var(--font-size--md);
    font-weight: 600;
    text-align: center;
  }

  .cart-recommendations__heading::before,
  .cart-recommendations__heading::after {
    content: '';
    flex: 1;
    height: 1px;
    background-color: rgb(var(--color-foreground-rgb) / 0.18);
  }

  .cart-recommendations__list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
  }

  .cart-recommendation {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr);
    gap: var(--gap-lg);
    align-items: start;
  }

  .cart-recommendation__media {
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    aspect-ratio: 3 / 4;
  }

  product-component .cart-recommendation { 
      grid-template-columns: 170px minmax(0, 1fr); 
  }

  .cart-recommendation__media-track {
    display: flex;
    height: 100%;
    transition: transform var(--animation-speed, 0.25s) var(--animation-easing, ease);
  }

  .cart-recommendation__image {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-recommendation__info {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
    min-width: 0;
  }

  .cart-recommendation__title {
    font-size: var(--font-size--md);
    font-weight: 600;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .cart-recommendation__price {
    font-size: var(--font-size--sm);
  }

  .cart-recommendation__options {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    margin-block-start: var(--margin-2xs);
  }

  .cart-recommendation__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .cart-recommendation__swatch {
    width: 18px;
    height: 18px;
    padding: 0;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
    border-radius: 2px;
    background-color: var(--swatch-background, transparent);
    background-image: var(--swatch-image, none);
    background-size: cover;
    background-position: center;
    cursor: pointer;
    outline-offset: 2px;
  }

  .cart-recommendation__swatch.is-selected {
    outline: 1px solid var(--color-foreground);
  }

  .cart-recommendation__sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .cart-recommendation__size {
    min-width: 44px;
    padding: 5px 6px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.15);
    border-radius: 2px;
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-size: var(--font-size--xs);
    line-height: 1.2;
    text-align: center;
    cursor: pointer;
  }

  .cart-recommendation__size.is-selected {
    border-color: transparent;
    background-color: #ececec;
  }

  .cart-recommendation__size[disabled],
  .cart-recommendation__size.is-unavailable {
    color: rgb(var(--color-foreground-rgb) / 0.3);
    cursor: not-allowed;
    background-image: linear-gradient(
      to top left,
      transparent calc(50% - 1px),
      rgb(var(--color-foreground-rgb) / 0.2) 50%,
      transparent calc(50% + 1px)
    );
  }

  .cart-recommendation__add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    margin-block-start: var(--margin-2xs);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-foreground);
    cursor: pointer;
  }

  .cart-recommendation__add svg {
    width: 22px;
    height: 22px;
  }

  .cart-recommendation__add[aria-disabled='true'] {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .cart-recommendation__add-spinner {
    display: none;
    width: 16px;
    height: 16px;
    border: 2px solid rgb(var(--color-foreground-rgb) / 0.25);
    border-top-color: var(--color-foreground);
    border-radius: 50%;
    animation: cart-recommendation-spin 0.6s linear infinite;
  }

  .cart-recommendation__add.is-loading .cart-recommendation__add-icon {
    display: none;
  }

  .cart-recommendation__add.is-loading .cart-recommendation__add-spinner {
    display: block;
  }

  @keyframes cart-recommendation-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .cart-media-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: rgb(255 255 255 / 0.9);
    color: #000;
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--animation-speed, 0.2s) ease;
  }

  .cart-media-nav svg {
    width: 14px;
    height: 14px;
  }

  .cart-media-nav--prev {
    inset-inline-start: 4px;
  }

  .cart-media-nav--next {
    inset-inline-end: 4px;
  }

  [data-media-carousel]:hover .cart-media-nav,
  [data-media-carousel]:focus-within .cart-media-nav {
    opacity: 1;
  }

  @media (hover: none) {
    .cart-media-nav {
      opacity: 1;
    }
  }
{% endstylesheet %}
