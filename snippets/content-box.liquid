<div class="product-info-benefits">
  <div class="product-info-benefits__top">
    {% if block.settings.feature_1_text != blank %}
      <div class="product-info-benefits__item">
        {% render 'feature-icon', icon: 'quality', class: 'product-info-benefits__icon' %}
        <span>
          {{ block.settings.feature_1_text }}
        </span>
      </div>
    {% endif %}
    {% if block.settings.feature_2_text != blank %}
      <div class="product-info-benefits__item">
        {% render 'feature-icon', icon: 'handmade', class: 'product-info-benefits__icon' %}
        <span>
          {{ block.settings.feature_2_text }}
        </span>
      </div>
    {% endif %}
    {% if block.settings.feature_3_text != blank %}
      <div class="product-info-benefits__item">
        {% render 'feature-icon', icon: 'stretch', class: 'product-info-benefits__icon' %}
        <span>
          {{ block.settings.feature_3_text }}
        </span>
      </div>
    {% endif %}
    {% if block.settings.feature_4_text != blank %}
      <div class="product-info-benefits__item">
        {% render 'feature-icon', icon: 'artwork', class: 'product-info-benefits__icon' %}
        <span>
          {{ block.settings.feature_4_text }}
        </span>
      </div>
    {% endif %}
  </div>
  {% if block.settings.tip_heading != blank or block.settings.tip_text != blank %}
    <div class="product-info-benefits__tip">
      <div class="product-info-benefits__tip-icon">
        <img src="https://cdn.shopify.com/s/files/1/0646/0761/files/idea.png?v=1788286019" height="28" width="28" alt="">
      </div>
      <div class="product-info-benefits__tip-content">
        {% if block.settings.tip_heading != blank %}
          <strong>
            {{ block.settings.tip_heading }}
          </strong>
        {% endif %}
        {% if block.settings.tip_text != blank %}
          <span>
            {{ block.settings.tip_text }}
          </span>
        {% endif %}
      </div>
    </div>
  {% endif %}
</div>
<style>
  .product-info-benefits {
    width: 100%;
    font-family: 'DM Sans', var(--font-body--family, sans-serif);
  }
  .product-info-benefits__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #f6f6f6;
    border: 1px solid #dfdfdf;
    padding: 14px 20px;
    border-radius: 10px;
    margin-bottom: 12px;
    gap: 12px;
  }
  .product-info-benefits__item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: #171717;
    white-space: nowrap;
  }
  .product-info-benefits__icon {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    object-fit: contain;
    color: #596f53;
  }
  .product-info-benefits__tip {
    display: flex;
    align-items: center;
    gap: 15px;
    background: #f6f6f6;
    border: 1px solid #dfdfdf;
    padding: 14px 20px;
    border-radius: 10px;
  }
  .product-info-benefits__tip-icon {
    width: 48px;
    height: 48px;
    min-width: 48px;
    border-radius: 50%;
    background: #eef1ea;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
  }
  .product-info-benefits__tip-icon img {
    width: auto;
  }
  .product-info-benefits__tip-content {
    font-size: 14px;
    line-height: 1.5;
    color: #171717;
  }
  .product-info-benefits__tip-content strong {
    font-weight: 600;
    color: #171717;
  }
  @media screen and (max-width: 767px) {
    .product-info-benefits__tip-icon {
      width: 40px;
      height: 40px;
      min-width: 40px;
    }
    .product-info-benefits__top {
      flex-wrap: wrap;
      justify-content: flex-start;
      padding: 14px 16px;
      gap: 12px;
    }
    .product-info-benefits__item {
      width: calc(50% - 6px);
      font-size: 13px;
      line-height: 1.35;
      white-space: normal;
    }
    .product-info-benefits__tip {
      align-items: flex-start;
      padding: 14px 16px;
      gap: 12px;
    }
    .product-info-benefits__tip-content {
      font-size: 14px;
      line-height: 1.5;
    }
  }
</style>
