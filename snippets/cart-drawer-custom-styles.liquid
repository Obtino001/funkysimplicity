{% doc %}
  Visual overrides for the custom cart drawer layout.

  Everything here is scoped to `.cart-drawer--custom` so the cart page and any
  other drawer keep the stock Horizon styling.

  @example
  {% render 'cart-drawer-custom-styles' %}
{% enddoc %}

{% stylesheet %}
  /* ---------------------------------------------------------------------- */
  /* Shell                                                                   */
  /* ---------------------------------------------------------------------- */

  .theme-drawer__dialog.cart-drawer--custom {
    --theme-drawer-padding: var(--padding-xl);
    --cart-drawer-padding: var(--padding-xl);
    max-width: 500px;
    overflow: visible;
  }

  .cart-drawer--custom .cart-drawer__inner {
    max-width: 500px;
  }

  .theme-drawer__dialog.cart-drawer--custom::backdrop {
    background: rgb(0 0 0 / 0.45);
  }

  .cart-drawer--custom .theme-drawer__header {
    align-items: flex-start;
    padding-block-end: 6px;
  }
/* 
  .cart-drawer--custom .theme-drawer__title {
    align-items: flex-start;
    gap: var(--gap-2xs);
    font-size: var(--font-size--xl);
    font-weight: 600;
  } */
  .cart-drawer--custom .theme-drawer__title {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    margin: 0;
    font-family: 'DM Sans' !important;
    font-weight: 600 !important;
    font-size: 16px !important;
  }
  .cart-drawer--custom .cart-drawer__title-icon {
    display: inline-flex;
    align-self: center;
  }

  .cart-drawer--custom .cart-drawer__title-icon svg {
    width: 22px;
    height: 20px;
  }

  .cart-drawer--custom .theme-drawer__badge {
    min-width: 20px;
    width: 20px;
    height: 20px;
    align-self: flex-start;
    padding: 0;
    border-radius: 999px;
    background: #f6f6f6;
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    color: #000;
  }

  .cart-drawer--custom .theme-drawer__close-button {
    width: 34px;
    height: 34px;
    min-height: 34px;
    padding: 0;
    background: transparent;
    border: 0;
    box-shadow: none;
  }

  .cart-drawer--custom .theme-drawer__close-button svg {
    width: 34px;
    height: 34px;
  }

  /* ---------------------------------------------------------------------- */
  /* Line items                                                              */
  /* ---------------------------------------------------------------------- */

  .cart-drawer--custom .cart-drawer__items .cart-items__table-row {
    --cart-item-price-width: auto;

    position: relative;
    grid-template-columns: 145px minmax(0, 1fr);
    grid-template-areas:
      'media details'
      'media variants'
      'media unit_price'
      'media quantity'
      'media error';
    column-gap: var(--gap-lg);
    align-items: start;
  }

  .cart-drawer--custom .cart-items__media-container {
    aspect-ratio: 3 / 4;
    border-radius: 2px;
  }

  .cart-drawer--custom .cart-items__media-container--carousel {
    display: block;
  }

  .cart-items__media-track {
    display: flex;
    height: 100%;
    transition: transform var(--animation-speed, 0.25s) var(--animation-easing, ease);
  }

  .cart-items__media-slide {
    flex: 0 0 100%;
    display: block;
    height: 100%;
  }

  .cart-drawer--custom .cart-items__media-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-drawer--custom .cart-items__title {
    font-size: var(--font-size--lg);
    font-weight: 600;
    line-height: 1.25;
  }

  .cart-drawer--custom .cart-items__details {
    color: var(--color-foreground);
  }

  /* "Color : Cream" — one option per line. */
  .cart-drawer--custom .cart-items__variants--stacked,
  .cart-drawer--custom .cart-items__properties {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-block-start: var(--margin-2xs);
  }

  .cart-drawer--custom .cart-items__variant,
  .cart-drawer--custom .cart-items__property {
    display: flex;
    gap: 4px;
    font-size: var(--font-size--sm);
  }

  .cart-drawer--custom .cart-items__variant dd,
  .cart-drawer--custom .cart-items__property dd {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  .cart-items__variant-label {
    color: var(--color-foreground);
    white-space: nowrap;
  }

  /* Price row: sale price, compare-at, then the savings pill. */
  .cart-drawer--custom .cart-items__unit-price-wrapper {
    margin-block-start: var(--margin-xs);
  }

  .cart-drawer--custom .cart-items__unit-price-wrapper > div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap-xs);
    font-size: var(--font-size--md);
  }

  .cart-drawer--custom .cart-items__unit-price-wrapper span:not(.visually-hidden):not(.cart-items__savings-badge) {
    color: #c08b2c;
  }

  .cart-drawer--custom .cart-items__unit-price-wrapper .compare-at-price {
    color: rgb(var(--color-foreground-rgb) / 0.45);
  }

  .cart-items__savings-badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: 999px;
    background-color: var(--color-foreground);
    color: var(--color-background);
    font-size: var(--font-size--xs);
    line-height: 1.2;
    white-space: nowrap;
  }

  /* The stock layout puts the line total in its own column; the drawer design
     shows the unit price inline instead, so hide the duplicate. */
  .cart-drawer--custom .cart-drawer__items .cart-items__price {
    display: none;
  }

  /* Quantity stepper as a rounded pill. */
  .cart-drawer--custom .cart-items__quantity {
    margin-block-start: var(--margin-md);
  }

  .cart-drawer--custom .cart-items__quantity .quantity-selector {
    gap: var(--gap-xs);
    padding: 2px 6px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    border-radius: 999px;
    background-color: var(--color-background);
  }

  .cart-drawer--custom .cart-items__quantity .quantity-selector input {
    width: 2.25rem;
    min-width: 0;
    border: 0;
    background: transparent;
    text-align: center;
    font-size: var(--font-size--md);
  }

  .cart-drawer--custom .cart-items__quantity .quantity-selector button {
    width: 28px;
    height: 28px;
    min-height: 0;
    padding: 0;
  }

  /* Remove button moves to the top-right of the row. */
  .cart-drawer--custom .cart-drawer__items .cart-items__remove {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    display: flex !important;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 28px !important;
    min-width: 28px !important;
    height: 28px !important;
    min-height: 28px !important;
    margin: 0 !important;
    padding: 0 !important;
    color: #111111 !important;
    background: transparent !important;
    border: 0 !important;
    border-radius: 0 !important;
    outline-color: currentColor;
    box-shadow: none !important;
    --button-background-color: transparent;
    --button-border-color: transparent;
    --button-border-width: 0px;
  }

  .cart-drawer--custom .cart-drawer__items .cart-items__remove svg {
    display: block !important;
    width: 20px !important;
    height: 20px !important;
    color: #111111 !important;
    stroke: currentColor !important;
    fill: none !important;
    opacity: 1 !important;
    visibility: visible !important;
    overflow: visible;
  }

  .cart-drawer--custom .cart-drawer__items .cart-items__remove svg path {
    stroke: currentColor !important;
    fill: none !important;
  }

  .cart-drawer--custom .cart-items__title-row {
    padding-inline-end: 36px;
  }

  @container cart-items (min-width: 720px) {
    /* Keep the drawer's stacked layout even when the container gets wide. */
    .cart-drawer--custom .cart-drawer__items .cart-items__table-row {
      grid-template-columns: 145px minmax(0, 1fr);
      grid-template-rows: auto;
      grid-template-areas:
        'media details'
        'media variants'
        'media unit_price'
        'media quantity'
        'media error';
    }

    .cart-drawer--custom .cart-drawer__items .cart-items__quantity {
      grid-area: quantity;
      margin-block-start: var(--margin-md);
    }
  }

  /* ---------------------------------------------------------------------- */
  /* Summary                                                                 */
  /* ---------------------------------------------------------------------- */

  .cart-drawer--custom .cart-drawer__title-icon {
    display: inline-flex;
  }

  .cart-drawer--custom .cart-drawer__summary {
    align-items: stretch;
    gap: var(--gap-md);
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    background-color: rgb(var(--color-foreground-rgb) / 0.03);
    position: relative;
    mask-image: none;
  }

  .cart-drawer--custom .cart-drawer__items {
    overflow: visible;
  }

  .cart-drawer--custom .additional-checkout-buttons,
  .cart-drawer--custom .cart-discount,
  .cart-drawer--custom .cart-totals__installments,
  .cart-drawer--custom shopify-accelerated-checkout-cart {
    display: none !important;
  }

  .cart-drawer--custom .cart-drawer__summary .cart-totals {
    gap: var(--gap-md);
  }

  /* Design order: subtotal first, then the order note. */
  .cart-drawer--custom .cart-drawer__summary .cart-totals__container {
    order: -1;
    row-gap: 2px;
  }

  .cart-drawer--custom .cart-drawer__summary .cart-actions {
    border: 0;
    margin-block-start: 0;
  }

  .cart-drawer--custom .cart-note__instructions--plain {
    margin-block-end: 20px;
  }

  .cart-drawer--custom .cart-drawer__summary .cart__ctas {
    margin-block-start: 4px;
  }

  .cart-drawer--custom cart-drawer-recommendations .cart-recommendation__add {
    display: none;
  }

  .cart-drawer--custom .cart-totals__total-label {
    font-size: var(--font-size--xl);
    font-weight: 600;
  }

  .cart-drawer--custom .cart-totals__total-value {
    font-size: var(--font-size--2xl);
    font-weight: 600;
  }

  .cart-drawer--custom .cart-totals__tax-note small {
    font-size: var(--font-size--sm);
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .cart-drawer--custom .cart__ctas .cart__checkout-button {
    height: 48px;
    border-radius: 999px;
    width: 100%;
    font-size: 14px;
    text-transform: uppercase;
    font-weight: 600;
    background-color: var(--color-foreground);
    color: var(--color-background);
    border: 0;
    font-size: var(--font-size--md);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cart-drawer--custom .cart-drawer__payment-icons {
    width: 100%;
    margin-block-start: calc(-1 * var(--gap-xs));
  }

  .cart-drawer--custom .cart-payment-icons {
    flex-wrap: nowrap;
    overflow: hidden;
    justify-content: center;
  }

  .cart-drawer--custom .cart-payment-icons__icon {
    width: 36px;
  }

  .cart-drawer--custom .cart-drawer__payment-icons:empty {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .theme-drawer__dialog.cart-drawer--custom {
      --theme-drawer-padding: 10px;
      --cart-drawer-padding: 10px;
      --theme-drawer-width: 100%;
      width: 100%;
      max-width: 100%;
    }

    .cart-drawer--custom .cart-drawer__inner {
      max-width: 100%;
    }

    .cart-drawer--custom .theme-drawer__header {
      padding: 20px 10px 10px;
      border-block-end: 1px solid rgb(0 0 0 / 0.1);
    }

    .cart-drawer--custom .theme-drawer__title {
      font-size: 18px !important;
      font-weight: 600 !important;
    }

    .cart-drawer--custom .cart-drawer__items .cart-items__table-row {
      grid-template-columns: 142px minmax(0, 1fr);
      column-gap: 14px;
      padding-block: 20px;
      padding-inline: 10px;
      grid-template-areas:
        'media details'
        'media variants'
        'media unit_price';
    }

    .cart-drawer--custom .cart-items__media-container {
      width: 142px;
      height: 208px;
      aspect-ratio: 142 / 208;
    }

    .cart-drawer--custom .cart-items__title {
      font-size: 15px;
      font-weight: 500;
    }

    .cart-drawer--custom .cart-items__variant,
    .cart-drawer--custom .cart-items__property {
      font-size: 14px;
    }

    .cart-drawer--custom .cart-items__unit-price-wrapper {
      grid-area: unit_price;
      align-self: end;
      padding-inline-end: 88px;
    }

    .cart-drawer--custom .cart-items__unit-price-wrapper span:not(.visually-hidden):not(.cart-items__savings-badge) {
      color: #e0ad40;
    }

    .cart-drawer--custom .cart-items__unit-price-wrapper .compare-at-price {
      color: #a8a8a8;
    }

    .cart-drawer--custom .cart-items__quantity {
      grid-area: unit_price;
      justify-self: end;
      align-self: end;
      margin: 0;
    }

    .cart-drawer--custom .cart-items__quantity .quantity-selector {
      gap: 10px;
      padding: 5px 10px;
    }

    .cart-drawer--custom .cart-totals__total-label,
    .cart-drawer--custom .cart-totals__total-value {
      font-size: 20px !important;
      font-weight: 600;
    }

    .cart-drawer--custom .cart-drawer__summary {
      background: #f6f6f6;
      padding: 10px 20px 16px;
      border: 0;
    }

    .cart-drawer--custom .cart-note__plain-label {
      font-size: 14px;
      text-align: start;
    }

    .cart-drawer--custom .cart-note__instructions--plain {
      height: 47px;
      min-height: 47px;
      border-radius: 90px;
      border: 1px solid rgb(0 0 0 / 0.1);
      background: #fff;
    }

    .cart-drawer--custom .cart__ctas .cart__checkout-button {
      width: 100%;
      height: auto;
      padding: 15px 25px;
      font-size: 14px;
      font-weight: 600;
      text-transform: uppercase;
    }

    .cart-complementary--inline .cart-complementary__heading {
      font-size: 16px;
      font-weight: 500;
      text-transform: capitalize;
      padding: 10px 10px 0;
    }

    .cart-complementary--inline .cart-complementary__list {
      flex-direction: row;
      overflow-x: auto;
      gap: 10px;
      padding-inline: 10px;
    }

    .cart-complementary--inline .cart-complementary-card {
      flex: 0 0 176px;
      width: 176px;
    }

    .cart-complementary--inline .cart-complementary-card__media {
      width: 176px;
      height: 267px;
    }

    .cart-complementary--inline .cart-complementary-card__title {
      font-size: 14px;
      font-weight: 500;
    }

    .cart-complementary--inline .cart-complementary-card__price {
      font-size: 12px;
    }
  }

  /* Figma cart drawer calibration --------------------------------------- */
  .theme-drawer__dialog.cart-drawer--custom {
    --theme-drawer-padding: 20px;
    --cart-drawer-padding: 20px;
    width: min(var(--theme-drawer-width), 100vw);
    max-width: min(var(--theme-drawer-width), 100vw);
    background: #fff;
    color: #111;
  }

  .cart-drawer--custom .cart-drawer__inner {
    max-width: none;
  }

  .cart-drawer--custom .theme-drawer__header {
    min-height: 54px;
    padding: 15px 20px 8px;
    align-items: center;
  }

  .cart-drawer--custom .theme-drawer__title {
    gap: 6px;
    font-size: 15px !important;
    line-height: 1;
  }

  .cart-drawer--custom .cart-drawer__title-icon svg {
    width: 17px;
    height: 17px;
  }

  /* Count is a small superscript in the reference, not a large pill. */
  .cart-drawer--custom .theme-drawer__badge,
  .cart-drawer--custom .theme-drawer__badge[data-maintain-ratio] {
    position: relative;
    top: -6px;
    display: inline;
    width: auto;
    min-width: 0;
    height: auto;
    padding: 0;
    border-radius: 0;
    background: transparent;
    color: #111;
    font-size: 9px;
    line-height: 1;
  }

  .cart-drawer--custom .theme-drawer__close-button {
    width: 26px;
    min-width: 26px;
    height: 26px;
    min-height: 26px;
    padding: 5px;
  }

  .cart-drawer--custom .theme-drawer__close-button svg {
    width: 16px;
    height: 16px;
  }

  .cart-drawer--custom .cart-free-shipping {
    padding: 0 20px 14px;
  }

  .cart-drawer--custom .cart-free-shipping__track {
    height: 6px;
    margin: 0 10px 12px 0;
    background: #e7e7e7;
  }

  .cart-drawer--custom .cart-free-shipping__knob {
    width: 22px;
    height: 22px;
  }

  .cart-drawer--custom .cart-free-shipping__message {
    min-height: 34px;
    padding: 6px 12px;
    font-size: 10px;
    line-height: 1.2;
  }

  .cart-drawer--custom .cart-free-shipping__icon svg {
    width: 17px;
    height: 17px;
  }

  .cart-drawer--custom .cart-drawer__items {
    padding-inline: 20px;
  }

  .cart-drawer--custom .cart-drawer__items .cart-items__table-row,
  .cart-drawer--custom .cart-drawer__items .cart-items__table-row--full-width-variants {
    grid-template-columns: 140px minmax(0, 1fr);
    grid-template-rows: repeat(4, min-content) 1fr;
    grid-template-areas:
      'media details'
      'media variants'
      'media unit_price'
      'media quantity'
      'media error';
    min-height: 190px;
    padding: 16px 0 22px;
    margin: 0;
    column-gap: 16px;
    border: 0;
  }

  .cart-drawer--custom .cart-items__media-container {
    width: 140px;
    height: 190px;
    aspect-ratio: 14 / 19;
    border-radius: 0;
  }

  .cart-drawer--custom .cart-items__title {
    font-size: 13px;
    line-height: 1.25;
  }

  .cart-drawer--custom .cart-items__variant,
  .cart-drawer--custom .cart-items__property {
    font-size: 10px;
    line-height: 1.35;
  }

  .cart-drawer--custom .cart-items__unit-price-wrapper > div {
    gap: 5px;
    font-size: 11px;
  }

  .cart-drawer--custom .cart-items__quantity .quantity-selector {
    display: grid;
    grid-template-columns: 25px 24px 25px;
    width: 76px;
    height: 28px;
    min-height: 28px;
    gap: 0;
    padding: 0;
  }

  .cart-drawer--custom .cart-items__quantity .quantity-selector button {
    width: 25px;
    height: 26px;
  }

  .cart-drawer--custom .cart-items__quantity .quantity-selector input {
    width: 24px;
    height: 26px;
    font-size: 11px;
  }

  .cart-drawer--custom .cart-drawer__items .cart-items__remove {
    inset-block-start: 12px;
    width: 22px !important;
    min-width: 22px !important;
    height: 22px !important;
    min-height: 22px !important;
    padding: 3px !important;
  }

  .cart-drawer--custom .cart-drawer__items .cart-items__remove svg {
    width: 14px !important;
    height: 14px !important;
  }

  .cart-drawer--custom cart-drawer-recommendations {
    padding: 5px 20px 18px;
  }

  .cart-drawer--custom .cart-recommendations__heading {
    min-height: 36px;
    margin: 0 0 16px;
    gap: 15px;
    font-size: 13px;
  }

  .cart-drawer--custom .cart-recommendations__list {
    gap: 14px;
  }

  .cart-drawer--custom .cart-recommendation {
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 14px;
  }

  .cart-drawer--custom .cart-recommendation__media {
    width: 110px;
    height: 148px;
    border-radius: 0;
  }

  .cart-drawer--custom .cart-recommendation__title {
    font-size: 12px;
    font-weight: 500;
  }

  .cart-drawer--custom .cart-recommendation__price {
    font-size: 10px;
  }

  .cart-drawer--custom .cart-recommendation__swatch {
    width: 13px;
    height: 13px;
  }

  .cart-drawer--custom .cart-recommendation__size {
    min-width: 31px;
    padding: 4px 3px;
    font-size: 8px;
  }

  .cart-drawer--custom .cart-complementary--aside {
    --cart-complementary-width: 320px;
    --cart-complementary-padding: 20px;
    width: 320px;
    border: 0;
    box-shadow: -1px 0 0 rgb(0 0 0 / 0.08);
  }

  .cart-drawer--custom .cart-complementary--aside .cart-complementary__heading {
    padding: 20px 20px 14px;
    font-size: 13px;
  }

  .cart-drawer--custom .cart-complementary--aside .cart-complementary__scroller {
    padding: 0 20px 20px;
  }

  .cart-drawer--custom .cart-complementary--aside .cart-complementary-card__media {
    height: 330px;
    aspect-ratio: auto;
  }

  .cart-drawer--custom .cart-complementary-card__title {
    font-size: 11px;
    font-weight: 500;
  }

  .cart-drawer--custom .cart-complementary-card__prices {
    font-size: 9px;
  }

  .cart-drawer--custom .cart-drawer__summary {
    gap: 8px;
    padding: 13px 20px 10px;
    border: 0;
    border-top: 1px solid #e8e8e8;
    background: #f6f6f6;
  }

  .cart-drawer--custom .cart-drawer__summary .cart-totals {
    gap: 7px;
  }

  .cart-drawer--custom .cart-totals__total-label,
  .cart-drawer--custom .cart-totals__total-value {
    font-size: 14px !important;
  }

  .cart-drawer--custom .cart-totals__tax-note small,
  .cart-drawer--custom .cart-note__plain-label {
    font-size: 9px;
  }

  .cart-drawer--custom .cart-note__instructions--plain {
    min-height: 34px !important;
    height: 34px;
    padding: 7px 12px;
    font-size: 10px;
  }

  .cart-drawer--custom .cart__ctas .cart__checkout-button {
    height: 38px;
    min-height: 38px;
    padding: 0 20px;
    font-size: 9px;
  }

  .cart-drawer--custom .cart-payment-icons__icon {
    width: 27px;
    max-height: 16px;
  }

  /* The global quantity component has a 44px touch target. In this compact
     drawer it made the plus/minus glyphs and the pill far larger than Figma. */
  .cart-drawer--custom .cart-items__quantity .quantity-selector {
    flex: 0 0 76px !important;
  }

  .cart-drawer--custom .cart-items__quantity .quantity-selector :is(.quantity-minus, .quantity-plus) {
    width: 25px !important;
    min-width: 25px !important;
    height: 26px !important;
    min-height: 26px !important;
  }

  .cart-drawer--custom .cart-items__quantity .quantity-selector .svg-wrapper,
