{% doc %}
  @prompt
    Generate a product variant selector where the Color option displays visual color swatches and all other options display text buttons:
    
    Option Labels: Font DM Sans, Medium weight (500), 16px font size, text color #000000 (e.g., 'Color: Cream Black').
    
    Color Option Specifics: Render as color swatch boxes instead of text buttons. Swatches are 28px x 28px with a 2px border-radius. Active/selected color swatch features a subtle bottom shadow/glow highlight effect.
    
    Size & Other Options (Text Buttons): Font DM Sans, Medium (500), 12px size. Height 28px, min-width 50px, padding 6px 12px, border-radius 2px.
    
    Unselected State: White background (#FFFFFF) with a light gray border (#E5E5E5).
    
    Selected State: Filled solid gray background (#ECECEC) with no border.
    
    Out of Stock State: White background with a diagonal cross-through line.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-variant-selector-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;font-family:{{ block.settings.font.family }},sans-serif;color:{{ block.settings.text_color }}}.ai-variant-selector-{{ ai_gen_id }}__group{margin:0 0 18px;padding:0;border:0}.ai-variant-selector-{{ ai_gen_id }}__label{display:block;margin:0 0 10px;font-size:16px;line-height:1.3;font-weight:500}.ai-variant-selector-{{ ai_gen_id }}__values{display:flex;flex-wrap:wrap;gap:8px}.ai-variant-selector-{{ ai_gen_id }}__option{position:relative;display:inline-flex;align-items:center;justify-content:center;height:28px;min-width:50px;padding:6px 12px;border:1px solid #E5E5E5;border-radius:2px;background:#FFFFFF;color:#000000;font:inherit;font-size:12px;line-height:1;font-weight:500;cursor:pointer}.ai-variant-selector-{{ ai_gen_id }}__option[aria-checked="true"]{border-color:#ECECEC;background:#ECECEC}.ai-variant-selector-{{ ai_gen_id }}__option[aria-disabled="true"]{cursor:not-allowed;overflow:hidden}.ai-variant-selector-{{ ai_gen_id }}__option[aria-disabled="true"]:after{content:"";position:absolute;width:140%;height:1px;background:#777;transform:rotate(-35deg)}.ai-variant-selector-{{ ai_gen_id }}__swatch{width:28px;min-width:28px;height:28px;padding:0;border-radius:2px;background:var(--swatch-color,#D8D8D8)}.ai-variant-selector-{{ ai_gen_id }}__swatch[aria-checked="true"]{border-color:#000;box-shadow:0 3px 0 #000,0 5px 8px rgba(0,0,0,.14)}.ai-variant-selector-{{ ai_gen_id }}__option:focus-visible{outline:2px solid #000;outline-offset:2px}.ai-variant-selector-{{ ai_gen_id }}__status{margin-top:4px;font-size:12px;color:#555}@media(max-width:749px){.ai-variant-selector-{{ ai_gen_id }}{width:100%}}{% endstyle %}
<variant-selector-{{ ai_gen_id }} class="ai-variant-selector-{{ ai_gen_id }}" data-product-variants='{{ product.variants | json | escape }}' {{ block.shopify_attributes }}>
{% for option in product.options_with_values %}{% assign option_name=option.name|downcase %}{% assign is_color=false %}{% if option_name contains 'color' or option_name contains 'colour' %}{% assign is_color=true %}{% endif %}<fieldset class="ai-variant-selector-{{ ai_gen_id }}__group" data-option-position="{{ option.position }}"><legend class="ai-variant-selector-{{ ai_gen_id }}__label">{{ option.name }}: <span data-selected-label>{{ option.selected_value }}</span></legend><div class="ai-variant-selector-{{ ai_gen_id }}__values" role="radiogroup" aria-label="{{ option.name | escape }}">{% for value in option.values %}{% assign v=value|downcase %}{% assign swatch_color='#D8D8D8' %}{% if v contains 'black' %}{% assign swatch_color='#111111' %}{% elsif v contains 'white' %}{% assign swatch_color='#FFFFFF' %}{% elsif v contains 'cream' %}{% assign swatch_color='#F3EBDD' %}{% elsif v contains 'red' %}{% assign swatch_color='#C62828' %}{% elsif v contains 'blue' %}{% assign swatch_color='#315A9A' %}{% elsif v contains 'green' %}{% assign swatch_color='#55745A' %}{% elsif v contains 'pink' %}{% assign swatch_color='#D98A9A' %}{% endif %}<button type="button" class="ai-variant-selector-{{ ai_gen_id }}__option{% if is_color %} ai-variant-selector-{{ ai_gen_id }}__swatch{% endif %}" data-option-value="{{ value | escape }}" aria-checked="{% if option.selected_value == value %}true{% else %}false{% endif %}" aria-label="{{ option.name | escape }}: {{ value | escape }}" style="{% if is_color %}--swatch-color:{{ swatch_color }};{% endif %}">{% unless is_color %}{{ value }}{% endunless %}</button>{% endfor %}</div></fieldset>{% endfor %}<div class="ai-variant-selector-{{ ai_gen_id }}__status" data-status aria-live="polite"></div><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id></variant-selector-{{ ai_gen_id }}>
<script>(function(){class VariantSelector{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.variants=JSON.parse(this.dataset.productVariants);this.groups=[...this.querySelectorAll('[data-option-position]')];this.input=this.querySelector('[data-variant-id]');this.status=this.querySelector('[data-status]');this.groups.forEach(group=>group.querySelectorAll('[data-option-value]').forEach(button=>button.addEventListener('click',()=>{if(button.getAttribute('aria-disabled')==='true')return;group.querySelectorAll('[data-option-value]').forEach(item=>item.setAttribute('aria-checked','false'));button.setAttribute('aria-checked','true');group.querySelector('[data-selected-label]').textContent=button.dataset.optionValue;this.update()})));this.update()}update(){const selected=this.groups.map(group=>group.querySelector('[aria-checked="true"]')?.dataset.optionValue);this.groups.forEach((group,index)=>group.querySelectorAll('[data-option-value]').forEach(button=>{const candidate=selected.slice();candidate[index]=button.dataset.optionValue;const possible=this.variants.some(variant=>variant.available&&variant.options.every((value,position)=>!candidate[position]||value===candidate[position]));button.setAttribute('aria-disabled',possible?'false':'true')}));const variant=this.variants.find(item=>item.options.every((value,index)=>value===selected[index]));if(variant){this.input.value=variant.id;this.status.textContent=variant.available?'':'This option is currently unavailable.'}}}customElements.define('variant-selector-{{ ai_gen_id }}',VariantSelector{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Variant selector","settings":[{"type":"font_picker","id":"font","label":"Font","default":"dm_sans_n5"},{"type":"color","id":"text_color","label":"Text","default":"#000000"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Variant selector"}],"tag":null,"class":"variant-selector-block"}{% endschema %}