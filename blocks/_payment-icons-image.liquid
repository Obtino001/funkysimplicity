{%- doc -%}
  Accepted payment methods rendered as Shopify's native inline SVG icons so the logos stay
  sharp at every screen size.
{%- enddoc -%}

{% assign payment_types = 'ideal,american_express,apple_pay,google_pay,klarna,maestro,master,paypal,shopify_pay,unionpay,visa' | split: ',' %}

<div
  class="payment-icons-image spacing-style"
  style="{% render 'spacing-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  <span class="visually-hidden">{{ 'blocks.payment_methods' | t }}</span>
  <ul class="payment-icons-image__list" role="list">
    {%- for type in payment_types -%}
      <li class="payment-icons-image__item">
        {{ type | payment_type_svg_tag: class: 'payment-icons-image__icon' }}
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .payment-icons-image {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .payment-icons-image__list {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .payment-icons-image__item {
    display: flex;
    align-items: center;
    line-height: 1;
  }

  .payment-icons-image__icon {
    display: block;
    width: 38px;
    height: auto;
    border-radius: 4px;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 8%);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Payment icons",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Payment icons",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
