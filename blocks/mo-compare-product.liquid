<div
  class="mo-compare-product"
  data-mo-compare-product
  data-product-id="{{ product.id }}"
>
  <div
    class="mo-compare-product__recommendations"
    data-mo-compare-recommendations
  >
    <div class="mo-compare-product__loading" aria-hidden="true">
      <span></span>
      <span></span>
    </div>
  </div>
</div>

<script>
  (() => {
    const container = document.querySelector(
      '[data-mo-compare-product][data-product-id="{{ product.id }}"]'
    );

    if (!container) return;

    const recommendationsContainer = container.querySelector(
      '[data-mo-compare-recommendations]'
    );

    if (!recommendationsContainer) return;

    const productId = container.dataset.productId;

    const url =
      window.Shopify.routes.root +
      'recommendations/products' +
      '?product_id=' +
      productId +
      '&limit=8' +
      '&section_id=mo-compare-recommendations' +
      '&intent=related';

    fetch(url)
      .then((response) => {
        if (!response.ok) {
          throw new Error('Failed to load recommendations');
        }

        return response.text();
      })
      .then((html) => {
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');

        const recommendations = doc.querySelector(
          '[data-mo-compare-recommendations]'
        );

        if (!recommendations) {
          recommendationsContainer.innerHTML = '';
          return;
        }

        if (!recommendations.innerHTML.trim()) {
          recommendationsContainer.innerHTML = '';
          return;
        }

        recommendationsContainer.innerHTML = recommendations.innerHTML;
      })
      .catch((error) => {
        console.error('Compare product recommendations:', error);
        recommendationsContainer.innerHTML = '';
      });
  })();
</script>
<style>
  h2.mo-compare-recommendations__title {
    font-size: 18px;
    color: #000000;
    font-family: 'DM Sans';
    font-weight: 500;
}
.mo-compare-recommendations__products {
    display: flex;
    flex-direction: row;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 12px;
}
.mo-compare-recommendations__products::-webkit-scrollbar {
    display: none;
}
.mo-compare-recommendations__item {
    flex: 0 0 45%;
    scroll-snap-align: start;
    min-width: 0;
}
.mo-compare-product__recommendations .cart-recommendation {
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.mo-compare-product__recommendations .cart-recommendation__media {
    width: 100%;
    aspect-ratio: 3 / 4;
}
.mo-compare-product__recommendations .cart-recommendation__info {
    width: 100%;
}
@media (min-width: 768px) {
    .mo-compare-recommendations__item {
        flex: 0 0 calc(33.333% - 11px);
    }
}
</style>
{% schema %}
{
  "name": "Mo Compare Product",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "Mo Compare Product"
    }
  ]
}
{% endschema %}
