<mo-compare-product
  class="mo-compare-product"
  data-mo-compare-product
  data-product-id="{{ product.id }}"
  data-url="{{ routes.product_recommendations_url }}"
  data-section-id="mo-compare-recommendations"
  data-limit="8"
  {{ block.shopify_attributes }}
>
  <div
    class="mo-compare-product__recommendations"
    data-mo-compare-recommendations
  >
    <div class="mo-compare-product__loading" aria-hidden="true">
      <span></span>
      <span></span>
    </div>
  </div>
</mo-compare-product>

<script
  type="module"
  src="{{ 'mo-compare-product.js' | asset_url }}"
  fetchpriority="low"
></script>
<script
  type="module"
  src="{{ 'cart-drawer-recommendations.js' | asset_url }}"
  fetchpriority="low"
></script>
{% stylesheet %}
  .mo-compare-product {
    display: block;
    width: 100%;
    min-width: 0;
    overflow: hidden;
    font-family: 'DM Sans', var(--font-body--family);
  }

  .mo-compare-product__recommendations {
    width: 100%;
    min-width: 0;
  }

  .mo-compare-product__loading {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .mo-compare-product__loading span {
    display: block;
    aspect-ratio: 3 / 4;
    border-radius: 10px;
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .mo-compare-product h2.mo-compare-recommendations__title {
    margin: 0 0 16px;
    color: #000000;
    font-family: 'DM Sans', var(--font-body--family);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.3;
  }

  .mo-compare-product .mo-compare-recommendations__products {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    padding-bottom: 0;
    overflow: visible;
  }

  .mo-compare-product .mo-compare-recommendations__products::-webkit-scrollbar {
    display: none;
  }

  .mo-compare-product .mo-compare-recommendations__item {
    flex: 0 0 auto;
    width: 100%;
    min-width: 0;
  }

  /* Compact: 3 items, the rest behind "Show more". */
  .mo-compare-product:not(.is-expanded) .mo-compare-recommendations__item.is-extra {
    display: none;
  }

  .mo-compare-product .mo-compare-recommendations__more {
    margin-top: 12px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-foreground);
    font-size: 13px;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .mo-compare-product .cart-recommendation {
    position: relative;
    display: grid;
    grid-template-columns: 136px minmax(0, 1fr);
    column-gap: 16px;
    align-items: stretch;
    width: 100%;
    min-width: 0;
  }

  .mo-compare-product .cart-recommendation__media {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    min-height: 170px;
    aspect-ratio: auto;
    align-self: stretch;
    overflow: hidden;
    border-radius: 10px;
    background-color: #f6f6f6;
  }

  .mo-compare-product .cart-recommendation__media-track {
    position: absolute;
    inset: 0;
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform var(--animation-speed, 0.25s) var(--animation-easing, ease);
  }

  .mo-compare-product .cart-recommendation__image,
  .mo-compare-product .cart-recommendation__media-track .placeholder-svg {
    display: block;
    flex: 0 0 100%;
    width: 100%;
    min-width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 15%;
  }

  .mo-compare-product .cart-recommendation__info {
    display: flex;
    flex-direction: column;
    gap: 7px;
    width: 100%;
    min-width: 0;
  }

  .mo-compare-product .cart-recommendation__title {
    display: -webkit-box;
    overflow: hidden;
    color: var(--color-foreground);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.35;
    text-decoration: none;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .mo-compare-product .cart-recommendation__price {
    color: var(--color-foreground, #171717);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
  }

  .mo-compare-product .cart-recommendation__options {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 2px;
  }

  .mo-compare-product .cart-recommendation__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .mo-compare-product .cart-recommendation__swatch {
    width: 18px;
    height: 18px;
    margin: 0;
    padding: 0;
    border: 1px solid #dfdfdf;
    border-radius: 50%;
    background-color: var(--swatch-background, transparent);
    background-image: var(--swatch-image, none);
    background-position: center;
    background-size: cover;
    box-shadow: none;
    cursor: pointer;
  }

  .mo-compare-product .cart-recommendation__swatch.is-selected {
    outline: 1.5px solid #596f53;
    outline-offset: 1px;
  }

  .mo-compare-product .cart-recommendation__size[disabled],
  .mo-compare-product .cart-recommendation__size.is-unavailable {
    display: none;
  }

  .mo-compare-product .cart-recommendation__sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .mo-compare-product .cart-recommendation__size {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 32px;
    padding: 6px 14px;
    border: 1px solid #dfdfdf;
    border-radius: 9999px;
    background-color: #ffffff;
    color: #171717;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .mo-compare-product .cart-recommendation__size:hover {
    background-color: #eef1ea;
    border-color: #596f53;
    color: #596f53;
  }

  .mo-compare-product .cart-recommendation__size.is-selected {
    border-color: #596f53;
    background-color: #596f53;
    color: #ffffff;
    font-weight: 600;
  }

  .mo-compare-product .cart-media-nav {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: rgb(255 255 255 / 0.92);
    color: #000000;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.16);
    cursor: pointer;
  }

  .mo-compare-product .cart-media-nav {
    top: 50%;
    width: 24px;
    height: 24px;
    opacity: 0;
    transform: translateY(-50%);
    transition: opacity var(--animation-speed, 0.2s) ease;
  }

  .mo-compare-product .cart-media-nav svg {
    width: 14px;
    height: 14px;
  }

  .mo-compare-product .cart-media-nav--prev {
    left: 6px;
  }

  .mo-compare-product .cart-media-nav--next {
    right: 6px;
  }

  .mo-compare-product [data-media-carousel]:hover .cart-media-nav,
  .mo-compare-product [data-media-carousel]:focus-within .cart-media-nav {
    opacity: 1;
  }

  .mo-compare-product .cart-recommendation__add {
    position: static;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    margin: 2px 0 0;
    padding: 0;
    border: 1px solid #596f53;
    border-radius: 9999px;
    background-color: #596f53;
    color: #ffffff;
    box-shadow: none;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .mo-compare-product .cart-recommendation__add:hover:not([aria-disabled='true']) {
    background-color: transparent;
    border-color: #596f53;
    color: #596f53;
  }

  .mo-compare-product .cart-recommendation__add svg {
    display: block;
    width: 17px;
    height: 17px;
  }

  .mo-compare-product .cart-recommendation__add[aria-disabled='true'] {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .mo-compare-product .cart-recommendation__add-spinner {
    display: none;
    width: 16px;
    height: 16px;
    border: 2px solid rgb(89 111 83 / 0.22);
    border-top-color: #596f53;
    border-radius: 50%;
    animation: mo-compare-spin 0.6s linear infinite;
  }

  .mo-compare-product .cart-recommendation__add.is-loading .cart-recommendation__add-icon {
    display: none;
  }

  .mo-compare-product .cart-recommendation__add.is-loading .cart-recommendation__add-spinner {
    display: block;
  }

  @keyframes mo-compare-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (hover: none) {
    .mo-compare-product .cart-media-nav {
      opacity: 1;
    }
  }

  @media screen and (max-width: 749px) {
    .mo-compare-product__loading {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .mo-compare-product .mo-compare-recommendations__products {
      flex-direction: row;
      gap: 10px;
      padding-bottom: 12px;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .mo-compare-product .mo-compare-recommendations__item {
      flex: 0 0 45%;
      width: auto;
      scroll-snap-align: start;
    }

    .mo-compare-product .cart-recommendation {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .mo-compare-product .cart-recommendation__media {
      width: 100%;
      height: auto;
      min-height: 0;
      aspect-ratio: 378 / 573;
      align-self: auto;
    }

    .mo-compare-product .cart-recommendation__size {
      min-width: 38px;
      min-height: 30px;
      padding: 5px 12px;
      font-size: 12px;
    }

    .mo-compare-product .cart-recommendation__add {
      width: 32px;
      height: 32px;
      min-width: 32px;
      min-height: 32px;
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Mo Compare Product",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "Mo Compare Product"
    }
  ]
}
{% endschema %}
