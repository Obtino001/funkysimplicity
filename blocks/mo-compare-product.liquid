<mo-compare-product
  class="mo-compare-product"
  data-mo-compare-product
  data-product-id="{{ product.id }}"
  data-url="{{ routes.product_recommendations_url }}"
  data-section-id="mo-compare-recommendations"
  data-limit="8"
  {{ block.shopify_attributes }}
>
  <div
    class="mo-compare-product__recommendations"
    data-mo-compare-recommendations
  >
    <div class="mo-compare-product__loading" aria-hidden="true">
      <span></span>
      <span></span>
    </div>
  </div>
</mo-compare-product>

<script
  type="module"
  src="{{ 'mo-compare-product.js' | asset_url }}"
  fetchpriority="low"
></script>
<script
  type="module"
  src="{{ 'cart-drawer-recommendations.js' | asset_url }}"
  fetchpriority="low"
></script>
</script>
<style>
  h2.mo-compare-recommendations__title {
    font-size: 18px;
    color: #000000;
    font-family: 'DM Sans';
    font-weight: 500;
}
.mo-compare-recommendations__products {
    display: flex;
    flex-direction: row;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 12px;
}
.mo-compare-recommendations__products::-webkit-scrollbar {
    display: none;
}
.mo-compare-recommendations__item {
    flex: 0 0 45%;
    scroll-snap-align: start;
    min-width: 0;
}
.mo-compare-product__recommendations .cart-recommendation {
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.mo-compare-product__recommendations .cart-recommendation__media {
    width: 100%;
    aspect-ratio: 3 / 4;
}
.mo-compare-product__recommendations .cart-recommendation__info {
    width: 100%;
}
@media (min-width: 768px) {
    .mo-compare-recommendations__item {
        flex: 0 0 calc(33.333% - 11px);
    }
}
</style>
{% schema %}
{
  "name": "Mo Compare Product",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "Mo Compare Product"
    }
  ]
}
{% endschema %}
