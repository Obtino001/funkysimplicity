    "google_reviews_grid_aghNbW": {
      "type": "google-reviews-grid",
      "blocks": {
        "review_kxQWXn": {
          "type": "review",
          "settings": {
            "author": "Susann Schramm",
            "avatar_color": "#e06d53",
            "rating": 5,
            "text": "I'm a big fan of Funky Simplicity. The leggings are part of my everyday outfits. Great style and quality for yoga and beyond. Thank you for creating such cozy fashion.",
            "date": "4 months ago",
            "show_google_badge": true
          }
        },
        "review_PUnC9J": {
          "type": "review",
          "settings": {
            "author": "Monali Reddy",
            "avatar_color": "#b93815",
            "rating": 5,
            "text": "The consistency in the quality of Funky Simplicity's clothing is why I had to come back and purchase myself another pair of high-waist flared leggings. They're of excellent quality and breathable material.",
            "date": "4 months ago",
            "show_google_badge": true
          }
        },
        "review_EPQWwE": {
          "type": "review",
          "settings": {
            "author": "Nicoletta Lenchi",
            "avatar_color": "#4d7c0f",
            "rating": 5,
            "text": "This is a wonderful shop with excellent items. I bought amazing pants years ago, I wear them so much and they still look beautiful. Very friendly and super professional.",
