      ],
      "settings": {
        "bg_color": "rgba(0,0,0,0)",
        "text_color": "{{ settings.color_palette.foreground }}",
        "icon_color": "{{ settings.color_palette.foreground }}",
        "show_dividers": true,
        "divider_color": "#c5c5c5",
        "icon_size": 60,
        "font_size": 18,
        "section_width": "page-width",
        "padding_top": 24,
