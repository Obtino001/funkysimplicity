            "text": "<h2>Get in touch</h2><p>Have questions about your order, sizing, or a general enquiry?</p>",
            "alignment": "center",
            "type_preset": "rte"
          },
          "blocks": {}
        },
        "cta_btn": {
          "type": "button",
          "settings": {
            "label": "Contact us",
            "link": "shopify://pages/contact",
            "style_class": "button",
            "width": "fit-content"
          },
          "blocks": {}
        }
      },
      "block_order": [
        "cta_text",
        "cta_btn"
      ],
      "settings": {
        "content_direction": "column",
        "horizontal_alignment_flex_direction_column": "center",
        "vertical_alignment_flex_direction_column": "center",
        "gap": 16,
        "section_width": "page-width",
        "padding-block-start": 48,
        "padding-block-end": 56
      }
    },
